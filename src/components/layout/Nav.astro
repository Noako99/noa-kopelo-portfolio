---
import { siteConfig } from '@config/site';

interface Props {
  /* Positions the nav inside a scaled Figma canvas instead of the viewport. */
  canvas?: boolean;
}

const { canvas = false } = Astro.props;
---

<nav class:list={['site-nav', { canvas }]} aria-label="Main navigation">
  <a class="nav-link nav-cv" style="view-transition-name: site-cv" href={siteConfig.cvUrl} target="_blank" rel="noopener noreferrer">CV</a>

  <div class="contact">
    <button
      class="nav-link contact-toggle"
      style="view-transition-name: site-contact"
      type="button"
      aria-expanded="false"
      aria-controls="contact-links"
    >
      Contact
    </button>

    <div class="contact-links" id="contact-links">
      {siteConfig.contact.map((link, i) => (
        <a
          class="contact-link"
          href={link.href}
          style={`--x:${link.x}; --i:${i};`}
          tabindex="-1"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  /* Outside the Figma canvas there is no --u to inherit, so one Figma pixel
     is just one CSS pixel and every coordinate below still reads literally. */
  .site-nav:not(.canvas) {
    --u: 1px;
    position: fixed;
    top: var(--content-top);
    left: min(var(--content-left), calc(100vw - 9rem));
    z-index: 100;
    display: flex;
    align-items: flex-start;
    gap: 2.6rem;
  }

  /* Canvas mode: Figma puts CV at 47,35 and the Contact component at 110,35. */
  /* Above the name, which is a 371x108 block sitting right where the contact
     links open across: without this it covered them and swallowed the clicks,
     so the email opened nothing. The layer itself lets every click through —
     only the links and the two words take one. */
  .site-nav.canvas {
    position: absolute;
    inset: 0;
    z-index: 110;
    display: block;
    pointer-events: none;
  }

  .site-nav.canvas .nav-cv {
    position: absolute;
    left: calc(47 * var(--ux, var(--u)));
    top: calc(35 * var(--u));
  }

  /* CONTACT keeps its 63 from CV, so the pair spreads as one. */
  .site-nav.canvas .contact {
    position: absolute;
    left: calc(47 * var(--ux, var(--u)) + 63 * var(--u));
    top: calc(35 * var(--u));
  }

  /* Figma: 20px General Sans Extralight, -1.4px tracking — set to -0.8px (-0.04em) at her ask. */
  .nav-link {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: calc(20 * var(--u));
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--color-text);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .contact {
    position: relative;
  }

  /* The open variant in Figma re-tracks CONTACT from -1.4px out to +4px, so the
     word itself expands as the links arrive. */
  /* A block, like CV. As an inline button it sat on the line of its 16px
     wrapper, whose baseline falls lower than a 20u word's, and CONTACT rode
     8 units below CV. */
  .contact-toggle {
    display: block;
    transition: letter-spacing var(--transition-normal);
  }

  .contact-toggle[aria-expanded='true'] {
    letter-spacing: 0.2em;
  }

  /* The links sit at their hand-placed Figma offsets, measured from the
     Contact component's own origin — the same in canvas and viewport mode. */
  .contact-links {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
  }

  .contact-link {
    position: absolute;
    top: 0;
    left: calc(var(--x) * var(--u));
    font-family: var(--font-display);
    font-weight: 200;
    font-size: calc(20 * var(--u));
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-0.75rem);
    pointer-events: none;
    transition:
      opacity var(--transition-normal),
      transform var(--transition-normal);
    transition-delay: calc(var(--i) * 70ms);
  }

  .contact.is-open .contact-link {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .contact-link:hover {
    color: var(--color-text);
  }

  /* ===== MOBILE =====
     One bar across the top of the page, not pinned — it scrolls away with the
     page rather than riding over the content. As Figma's "iPhone 17" frame
     has it: CONTACT on the 20 margin at the left, CV on the one at the right,
     both at 35 in 20 Extralight; CONTACT's links drop under it. */
  @media (max-width: 640px) {
    .site-nav.canvas {
      position: absolute;
      inset: auto;
      top: calc(35 * var(--m));
      left: calc(20 * var(--m));
      right: calc(20 * var(--m));
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      pointer-events: auto;
      z-index: 110;
    }

    .site-nav.canvas .nav-cv,
    .site-nav.canvas .contact {
      position: relative;
      left: auto;
      top: auto;
    }

    .site-nav.canvas .contact {
      order: -1;
    }

    .nav-link {
      font-size: calc(20 * var(--m));
      line-height: 1.35;
    }

    .contact-toggle[aria-expanded='true'] {
      letter-spacing: 0.1em;
    }

    .contact-links {
      position: absolute;
      top: calc(100% + 6 * var(--m));
      left: 0;
      right: auto;
      height: auto;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: calc(8 * var(--m));
    }

    .contact-link {
      position: static;
      transform: translateY(calc(-6 * var(--m)));
      font-size: calc(13 * var(--m));
    }

    .contact.is-open .contact-link {
      transform: none;
    }
  }
</style>

<script>
  const contact = document.querySelector<HTMLElement>('.contact');
  const toggle = contact?.querySelector<HTMLButtonElement>('.contact-toggle');
  const links = contact?.querySelectorAll<HTMLAnchorElement>('.contact-link');

  const setOpen = (open: boolean) => {
    contact?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    /* Keep the links out of the tab order while they are invisible. */
    links?.forEach((link) => link.setAttribute('tabindex', open ? '0' : '-1'));
  };

  toggle?.addEventListener('click', () => {
    setOpen(!contact?.classList.contains('is-open'));
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (!contact?.contains(event.target)) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && contact?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
