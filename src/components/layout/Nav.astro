---
import { siteConfig } from '@config/site';

interface Props {
  /* Positions the nav inside a scaled Figma canvas instead of the viewport. */
  canvas?: boolean;
}

const { canvas = false } = Astro.props;
---

<nav class:list={['site-nav', { canvas }]} aria-label="Main navigation">
  <a class="nav-link nav-cv" href={siteConfig.cvUrl} target="_blank" rel="noopener noreferrer">CV</a>

  <div class="contact">
    <button
      class="nav-link contact-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="contact-links"
    >
      Contact
    </button>

    <div class="contact-links" id="contact-links">
      {siteConfig.contact.map((link, i) => (
        <a
          class="contact-link"
          href={link.href}
          style={`--x:${link.x}; --i:${i};`}
          tabindex="-1"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  /* Outside the Figma canvas there is no --u to inherit, so one Figma pixel
     is just one CSS pixel and every coordinate below still reads literally. */
  .site-nav:not(.canvas) {
    --u: 1px;
    position: fixed;
    top: var(--content-top);
    left: min(var(--content-left), calc(100vw - 9rem));
    z-index: 100;
    display: flex;
    align-items: flex-start;
    gap: 2.6rem;
  }

  /* Canvas mode: Figma puts CV at 47,35 and the Contact component at 110,35. */
  .site-nav.canvas {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
  }

  .site-nav.canvas .nav-cv {
    position: absolute;
    left: calc(47 * var(--u));
    top: calc(35 * var(--u));
  }

  .site-nav.canvas .contact {
    position: absolute;
    left: calc(110 * var(--u));
    top: calc(35 * var(--u));
  }

  /* Figma: 20px General Sans Extralight, -1.4px tracking, uppercase. */
  .nav-link {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: calc(20 * var(--u));
    letter-spacing: -0.07em;
    text-transform: uppercase;
    color: var(--color-text);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .contact {
    position: relative;
  }

  /* The open variant in Figma re-tracks CONTACT from -1.4px out to +4px, so the
     word itself expands as the links arrive. */
  .contact-toggle {
    transition: letter-spacing var(--transition-normal);
  }

  .contact-toggle[aria-expanded='true'] {
    letter-spacing: 0.2em;
  }

  /* The links sit at their hand-placed Figma offsets, measured from the
     Contact component's own origin — the same in canvas and viewport mode. */
  .contact-links {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
  }

  .contact-link {
    position: absolute;
    top: 0;
    left: calc(var(--x) * var(--u));
    font-family: var(--font-display);
    font-weight: 200;
    font-size: calc(20 * var(--u));
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-0.75rem);
    pointer-events: none;
    transition:
      opacity var(--transition-normal),
      transform var(--transition-normal);
    transition-delay: calc(var(--i) * 70ms);
  }

  .contact.is-open .contact-link {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .contact-link:hover {
    color: var(--color-text);
  }

  /* ===== MOBILE =====
     No room to open sideways, so the links stack under the word instead. */
  @media (max-width: 900px) {
    .site-nav.canvas {
      --u: 1px;
      position: fixed;
      inset: auto;
      top: var(--content-top);
      left: var(--content-left);
      display: flex;
      align-items: flex-start;
      gap: 2.6rem;
      pointer-events: auto;
    }

    .site-nav.canvas .nav-cv,
    .site-nav.canvas .contact {
      position: static;
    }

    .site-nav.canvas .contact {
      position: relative;
    }

    .contact-toggle[aria-expanded='true'] {
      letter-spacing: -0.07em;
    }

    .contact-links {
      position: absolute;
      top: calc(100% + 0.75rem);
      left: 0;
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .contact-link {
      position: static;
      transform: translateY(-0.4rem);
      font-size: 1rem;
    }

    .contact.is-open .contact-link {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .site-nav:not(.canvas) {
      top: 1.25rem;
      left: 1.25rem;
      gap: 1.5rem;
    }
  }
</style>

<script>
  const contact = document.querySelector<HTMLElement>('.contact');
  const toggle = contact?.querySelector<HTMLButtonElement>('.contact-toggle');
  const links = contact?.querySelectorAll<HTMLAnchorElement>('.contact-link');

  const setOpen = (open: boolean) => {
    contact?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    /* Keep the links out of the tab order while they are invisible. */
    links?.forEach((link) => link.setAttribute('tabindex', open ? '0' : '-1'));
  };

  toggle?.addEventListener('click', () => {
    setOpen(!contact?.classList.contains('is-open'));
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (!contact?.contains(event.target)) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && contact?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
