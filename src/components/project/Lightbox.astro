---
/* Pictures on a page that open large when clicked, right over the page: the
   picture grows out of its own spot to the middle of the window, with
   nothing laid behind it, and pages through the rest — with her red arrows,
   the keyboard's arrows, a click on the picture, or a swipe. Scrolling on,
   a click beside it, or Escape sends it back into its place.

   `selector` picks the pictures (their <img>s), in the order they are paged
   through: the order they stand in the page. */
interface Props {
  selector: string;
  label?: string;
}

const { selector, label = 'Pictures' } = Astro.props;
---

<div class="lightbox" data-lightbox={selector} role="dialog" aria-label={label} hidden>
  <img class="lb-image" alt="" />

  <button class="lb-arrow lb-prev" type="button" aria-label="Previous picture">
    <svg viewBox="0 0 26 26" fill="none" aria-hidden="true">
      <path d="M0.353267 12.208L12.5614 24.4161L24.7695 12.208M12.5614 24.4161L12.5614 -0.000125067" />
    </svg>
  </button>
  <button class="lb-arrow lb-next" type="button" aria-label="Next picture">
    <svg viewBox="0 0 26 26" fill="none" aria-hidden="true">
      <path d="M0.353267 12.208L12.5614 24.4161L24.7695 12.208M12.5614 24.4161L12.5614 -0.000125067" />
    </svg>
  </button>
</div>

<style>
  /* A clear layer over the page: it only catches the click beside the
     picture that puts it away. */
  .lightbox {
    --px: calc(100vw / 1728);
    position: fixed;
    inset: 0;
    z-index: 300;
    cursor: zoom-out;
  }

  .lightbox[hidden] {
    display: none;
  }

  /* Placed and sized by the script, from its spot in the page to the
     middle of the window. A soft shadow lifts it off the page under it. */
  .lb-image {
    position: fixed;
    left: 0;
    top: 0;
    display: block;
    max-width: none;
    transform-origin: 0 0;
    box-shadow: 0 calc(18 * var(--u)) calc(60 * var(--u)) rgba(0, 0, 0, 0.22);
    cursor: pointer;
    transition: transform 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* Her 26x26 arrow, pointing down in the file, turned to point the way —
     as PREV / NEXT turn it — on the 47 margins. They come up once the
     picture has opened. */
  .lb-arrow {
    position: absolute;
    top: 50%;
    width: calc(44 * var(--u));
    height: calc(44 * var(--u));
    margin-top: calc(-22 * var(--u));
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .lightbox.is-open .lb-arrow {
    opacity: 1;
    transition-delay: 220ms;
  }

  .lb-arrow svg {
    width: calc(26 * var(--u));
    height: calc(26 * var(--u));
    overflow: visible;
    transition: translate 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .lb-arrow path {
    stroke: var(--color-accent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .lb-prev {
    left: calc(47 * var(--px));
  }

  .lb-prev svg {
    transform: rotate(90deg);
  }

  .lb-next {
    right: calc(47 * var(--px));
  }

  .lb-next svg {
    transform: rotate(-90deg);
  }

  .lb-prev:hover svg {
    translate: calc(-6 * var(--u)) 0;
  }

  .lb-next:hover svg {
    translate: calc(6 * var(--u)) 0;
  }

  @media (max-width: 640px) {
    .lb-arrow {
      top: auto;
      bottom: calc(22 * var(--m));
      margin: 0;
      width: calc(44 * var(--m));
      height: calc(44 * var(--m));
    }

    .lb-arrow svg {
      width: calc(22 * var(--m));
      height: calc(22 * var(--m));
    }

    .lb-prev {
      left: calc(10 * var(--m));
    }

    .lb-next {
      right: calc(10 * var(--m));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb-image,
    .lb-arrow {
      transition: none;
    }
  }
</style>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-lightbox]')) {
    const pictures = [...document.querySelectorAll<HTMLImageElement>(box.dataset.lightbox ?? '')];
    if (!pictures.length) continue;

    const image = box.querySelector<HTMLImageElement>('.lb-image')!;
    const phone = window.matchMedia('(max-width: 640px)');
    let index = 0;
    let open = false;
    let opener: HTMLElement | null = null;
    /* Focus goes back to the picture only when it was opened from the
       keyboard: handed back after a click, the browser drew its red focus
       ring round the square (closing with Escape counts as the keyboard). */
    let byKeyboard = false;

    /* Where a picture opens to: as large as its shape allows in the middle
       of the window, clear of the arrows on the 47 margins and of the bar. */
    const spot = (picture: HTMLImageElement) => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const ratio = (picture.naturalWidth || 1) / (picture.naturalHeight || 1);
      const roomW = phone.matches ? vw - 40 : vw - 2 * Math.max(120, vw * (140 / 1728));
      const roomH = phone.matches ? vh - 180 : vh - 2 * Math.max(60, vh * (90 / 982));
      const w = Math.min(roomW, roomH * ratio);
      const h = w / ratio;
      return { x: (vw - w) / 2, y: (vh - h) / 2, w, h };
    };

    /* The picture laid at a box: placed at the open size, and scaled down
       from there, so it grows and shrinks on the GPU alone. */
    const lay = (to: { x: number; y: number; w: number; h: number }, size: { w: number; h: number }) => {
      image.style.transform = `translate(${to.x}px, ${to.y}px) scale(${to.w / size.w}, ${to.h / size.h})`;
    };

    const show = (i: number) => {
      index = (i + pictures.length) % pictures.length;
      const picture = pictures[index];
      image.src = picture.currentSrc || picture.src;
      image.alt = picture.alt;
      const target = spot(picture);
      image.style.width = `${target.w}px`;
      image.style.height = `${target.h}px`;
      lay(target, target);
    };

    const thumb = (i: number) => {
      const r = pictures[i].getBoundingClientRect();
      return { x: r.left, y: r.top, w: r.width, h: r.height };
    };

    const openAt = (i: number, from: HTMLElement) => {
      opener = from;
      index = i;
      const target = spot(pictures[i]);
      image.src = pictures[i].currentSrc || pictures[i].src;
      image.alt = pictures[i].alt;
      image.style.width = `${target.w}px`;
      image.style.height = `${target.h}px`;
      /* Out of its own spot, without a transition, then to the middle. */
      image.style.transition = 'none';
      lay(thumb(i), target);
      box.hidden = false;
      void image.offsetWidth;
      image.style.transition = '';
      lay(target, target);
      box.classList.add('is-open');
      open = true;
    };

    const close = () => {
      if (!open) return;
      open = false;
      box.classList.remove('is-open');
      /* Back into the spot of the picture it shows now. */
      lay(thumb(index), { w: parseFloat(image.style.width), h: parseFloat(image.style.height) });
      window.setTimeout(() => {
        if (!open) box.hidden = true;
      }, 420);
      if (byKeyboard) opener?.focus({ preventScroll: true });
    };

    pictures.forEach((picture, i) => {
      /* Each picture's box takes the click and the keyboard. */
      const target = (picture.closest('.item') as HTMLElement | null) ?? picture;
      target.style.cursor = 'zoom-in';
      target.tabIndex = 0;
      target.setAttribute('role', 'button');
      target.setAttribute('aria-label', `Open picture ${i + 1} of ${pictures.length}`);
      target.addEventListener('click', () => {
        byKeyboard = false;
        openAt(i, target);
      });
      target.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          byKeyboard = true;
          openAt(i, target);
        }
      });
    });

    box.querySelector('.lb-prev')?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(index - 1);
    });
    box.querySelector('.lb-next')?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(index + 1);
    });
    image.addEventListener('click', (e) => {
      e.stopPropagation();
      show(index + 1);
    });
    /* A click beside it puts it away. */
    box.addEventListener('click', close);

    addEventListener('keydown', (e) => {
      if (!open) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    /* Scrolling on puts it back too: the page carries on under it. */
    addEventListener('wheel', () => open && close(), { passive: true });
    addEventListener('resize', () => open && show(index));

    /* A swipe pages on a phone; a drag up or down puts it away. */
    let startX = 0;
    let startY = 0;
    box.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    box.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
      else if (Math.abs(dy) > 40) close();
    });
  }
</script>
