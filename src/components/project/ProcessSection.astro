---
/* A project's process, under its work: a PROCESS heading and the pictures
   in rows. Each row is one height, and each picture keeps its own shape in
   it — it takes a share of the row's width in proportion to how wide it is
   for its height — so pictures of any shape sit flush, edge to edge with
   the margins. On the site's 47 margins, 20 apart; 100 above, the gap the
   pager keeps above PREV / NEXT. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /* Rows of pictures, top to bottom. */
  rows: { src: ImageMetadata; alt: string }[][];
  /* The gap above it, in Figma units: 100 as above PREV / NEXT, more where
     the work above it still moves with the scroll. */
  gap?: number;
  /* Edges to line up with the work above, in the units of its Figma frame:
     where the page's frame is `frame` wide, the process runs from `left` to
     `right` (06: its portraits, 89 to 1422 of 1512). Without them it keeps
     the site's 47 margins. */
  edges?: { frame: number; left: number; right: number };
}

const { rows, gap = 100, edges } = Astro.props;
const inset = edges
  ? `--in-l:calc(100vw * ${edges.left} / ${edges.frame}); --in-w:calc(100vw * ${edges.right - edges.left} / ${edges.frame});`
  : '';
---

<section class="process" class:list={[{ edged: !!edges }]} aria-labelledby="process-title" style={`--gap:${gap}; ${inset}`}>
  <h2 class="process-title" id="process-title">Process</h2>
  {rows.map((row) => (
    <div class="process-row" class:list={[{ single: row.length === 1 }]}>
      {row.map((picture) => (
        <Image
          src={picture.src}
          alt={picture.alt}
          widths={[800, 1200, 1700]}
          sizes="(max-width: 640px) 50vw, 60vw"
          loading="lazy"
          style={`--ratio:${(picture.src.width / picture.src.height).toFixed(4)};`}
        />
      ))}
    </div>
  ))}
</section>

<style>
  .process {
    --px: calc(100vw / 1728);
    padding: calc(var(--gap) * var(--u)) calc(47 * var(--px)) 0;
  }

  /* Placed by its left edge and its width, as the canvas places its pieces:
     a right margin would be taken from the page less its scrollbar, and
     stop short of the work above. */
  .process.edged {
    box-sizing: content-box;
    width: var(--in-w);
    padding-left: var(--in-l);
    padding-right: 0;
  }

  /* In the paragraph's voice: 18, uppercase, 0.2em. */
  .process-title {
    margin: 0 0 calc(24 * var(--u));
    font-family: var(--font-body);
    font-weight: 400;
    font-size: calc(18 * var(--u));
    letter-spacing: 0.2em;
    line-height: 1.24;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .process-row {
    display: flex;
    gap: calc(20 * var(--px));
  }

  .process-row + .process-row {
    margin-top: calc(20 * var(--px));
  }

  .process-row :global(img) {
    flex: var(--ratio) 1 0;
    min-width: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  /* A picture alone on its row is held to 90% of the window's height, so
     it is seen whole with a little page round it, and centred: across the
     full width 06's sketch stood 906 high, taller than the window, and at
     three quarters it read too small. */
  .process-row.single {
    justify-content: center;
  }

  .process-row.single :global(img) {
    flex: none;
    height: 90vh;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .process {
      padding: calc(var(--gap) * 0.4 * var(--m)) calc(20 * var(--m)) 0;
    }

    /* On a phone every page keeps the column's 20 margins. */
    .process.edged {
      width: auto;
      padding-left: calc(20 * var(--m));
      padding-right: calc(20 * var(--m));
    }

    .process-title {
      margin-bottom: calc(12 * var(--m));
      font-size: calc(12 * var(--m));
    }

    .process-row {
      gap: calc(8 * var(--m));
    }

    .process-row + .process-row {
      margin-top: calc(8 * var(--m));
    }
  }
</style>
