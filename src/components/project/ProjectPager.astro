---
/* The foot of a project page: PREV on the left edge, NEXT on the right, each
   with her arrow turned to point the way. Hovering one fills the whole
   window behind it with that project's backdrop — the same picture its
   hover brings up on the home page — and puts up its number and title where
   they stand in the home page's list, so you see where you are going before
   you go. The list wraps: after 07 comes 01. */
import { Image } from 'astro:assets';
import { projectOrder } from '@config/projects';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const at = projectOrder.findIndex((p) => p.slug === slug);
const count = projectOrder.length;
const prev = projectOrder[(at - 1 + count) % count];
const next = projectOrder[(at + 1) % count];

const links = [
  { dir: 'prev', label: 'Prev', project: prev },
  { dir: 'next', label: 'Next', project: next },
] as const;
---

<nav class="pager" aria-label="More projects">
  {links.map(({ dir, project }) => (
    <div
      class="pager-bg"
      data-for={dir}
      style={project.backdrop.opacity ? `--bg-opacity:${project.backdrop.opacity};` : ''}
      aria-hidden="true"
    >
      {'video' in project.backdrop ? (
        <video muted loop playsinline preload="none">
          <source src={`${project.backdrop.video}.webm`} type="video/webm" />
          <source src={`${project.backdrop.video}.mp4`} type="video/mp4" />
        </video>
      ) : (
        <Image src={project.backdrop.src} alt="" widths={[1512, 2268]} sizes="100vw" quality={82} loading="lazy" />
      )}
      <span
        class="pager-title"
        data-slug={project.slug}
        style={`--x:${project.spot.x}; --y:${project.spot.y}; --w:${project.spot.w};`}
      >
        <span class="pager-title-num">{project.number}</span>
        <span class="pager-title-name">{project.title}</span>
      </span>
    </div>
  ))}

  {links.map(({ dir, label, project }) => (
    <a class="pager-link" data-dir={dir} href={`${base}/projects/${project.slug}`} aria-label={`${label}: ${project.title}`}>
      {/* Her 26x26 arrow points down; turned a quarter it points the way. */}
      <svg class="pager-arrow" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <path d="M0.353267 12.208L12.5614 24.4161L24.7695 12.208M12.5614 24.4161L12.5614 -0.000125067" />
      </svg>
      <span class="pager-label">{label}</span>
    </a>
  ))}
</nav>

<style>
  /* One Figma pixel of the home frame across the page's width, the same
     measure the header spreads by, so the two words sit 47 in from the
     edges — where CV sits — on any window. */
  .pager {
    --px: calc(100vw / 1728);
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    /* 100 under the end of the page's content on every project: whatever
       comes before it ends where its content is seen to end. */
    padding: calc(100 * var(--u)) calc(47 * var(--px)) calc(80 * var(--u));
  }

  /* Pinned to the window, under the two links and over everything else on
     the page, so the whole glass fills with the next project. */
  .pager-bg {
    position: fixed;
    inset: 0;
    z-index: 150;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 420ms ease,
      visibility 0s linear 420ms;
  }

  .pager-bg.is-active {
    opacity: var(--bg-opacity, 1);
    visibility: visible;
    transition:
      opacity 420ms ease,
      visibility 0s;
  }

  /* The project's title where the home page lists it. The home frame is
     1728x982, spread across the width and fitted to the height, and centred
     in the window's height: so x runs on the window's width and y is measured
     from the frame's middle, at the window's. Type as the list sets it. */
  .pager-title {
    position: absolute;
    left: calc(var(--x) * var(--px));
    top: calc(50vh + (var(--y) - 491) * var(--u));
    width: calc(var(--w) * var(--u));
    color: var(--color-text);
  }

  .pager-title-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 200;
    font-size: calc(18 * var(--u));
    letter-spacing: -0.04em;
    color: var(--color-accent);
  }

  .pager-title-name {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: calc(18 * var(--u));
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  /* One line each, as on the home page. */
  .pager-title[data-slug='noa-atalia'] .pager-title-name,
  .pager-title[data-slug='3-generations'] .pager-title-name {
    white-space: nowrap;
  }

  .pager-bg :global(img),
  .pager-bg video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pager-link {
    position: relative;
    z-index: 160;
    display: flex;
    align-items: center;
    gap: calc(14 * var(--u));
    color: var(--color-text);
    text-decoration: none;
  }

  /* NEXT reads arrow-last and hugs the right edge. */
  .pager-link[data-dir='next'] .pager-arrow {
    order: 2;
    transform: rotate(-90deg);
  }

  .pager-link[data-dir='prev'] .pager-arrow {
    transform: rotate(90deg);
  }

  /* 26 x 26, as the file draws it, in the accent red. */
  .pager-arrow {
    width: calc(26 * var(--u));
    height: calc(26 * var(--u));
    overflow: visible;
    transition: translate 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .pager-arrow path {
    stroke: var(--color-accent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* The nav's voice: CV and CONTACT's 20, Extralight, uppercase. */
  .pager-label {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: calc(20 * var(--u));
    letter-spacing: -0.04em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* The arrow leans the way it points. */
  .pager-link[data-dir='next']:hover .pager-arrow,
  .pager-link[data-dir='next']:focus-visible .pager-arrow {
    translate: calc(8 * var(--u)) 0;
  }

  .pager-link[data-dir='prev']:hover .pager-arrow,
  .pager-link[data-dir='prev']:focus-visible .pager-arrow {
    translate: calc(-8 * var(--u)) 0;
  }

  /* On a phone: the two words on the 20 margins, clear of the corner mark
     that sits under them at the bottom left. */
  @media (max-width: 640px) {
    .pager {
      --u: var(--m);
      padding: calc(56 * var(--m)) calc(20 * var(--m)) calc(72 * var(--m));
    }

    .pager-label {
      font-size: calc(16 * var(--m));
    }

    .pager-arrow {
      width: calc(22 * var(--m));
      height: calc(22 * var(--m));
    }

    /* No hover on a phone: the page stays put. */
    .pager-bg {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pager-arrow {
      transition: none;
    }
  }
</style>

<script>
  /* Where the opening frame itself is the end of the page's content (03,
     whose phone runs past the fold), the pager is measured against the last
     thing drawn in it, so the gap above PREV / NEXT is the same as on every
     other page. The frame's own foot is set in Figma units, but some of what
     hangs under the phone is sized in plain pixels. */
  const seat = (pager: HTMLElement) => {
    let before = pager.previousElementSibling as HTMLElement | null;
    while (before && (before.tagName === 'SCRIPT' || before.tagName === 'STYLE')) {
      before = before.previousElementSibling as HTMLElement | null;
    }
    if (!before || !before.classList.contains('canvas-wrap')) return;
    if (window.matchMedia('(max-width: 640px)').matches) return;
    let deepest = -Infinity;
    before.querySelectorAll<HTMLElement>('.stay, .stay *').forEach((el) => {
      if (getComputedStyle(el).position === 'fixed') return;
      const r = el.getBoundingClientRect();
      if (r.height > 0) deepest = Math.max(deepest, r.bottom);
    });
    if (deepest === -Infinity) return;
    pager.style.marginTop = `${(deepest - before.getBoundingClientRect().bottom).toFixed(1)}px`;
  };

  document.querySelectorAll<HTMLElement>('.pager').forEach((pager) => {
    seat(pager);
    addEventListener('resize', () => seat(pager));

    const layers = pager.querySelectorAll<HTMLElement>('.pager-bg');

    const show = (dir: string | null) => {
      layers.forEach((layer) => {
        const active = layer.dataset.for === dir;
        layer.classList.toggle('is-active', active);
        const video = layer.querySelector('video');
        if (!video) return;
        if (active) {
          video.muted = true;
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    };

    pager.querySelectorAll<HTMLAnchorElement>('.pager-link').forEach((link) => {
      const dir = link.dataset.dir ?? null;
      link.addEventListener('mouseenter', () => show(dir));
      link.addEventListener('mouseleave', () => show(null));
      link.addEventListener('focus', () => show(dir));
      link.addEventListener('blur', () => show(null));
    });

    /* Coming back to the page with the browser's back button restores it
       from the cache, hover and all; start clean. */
    addEventListener('pageshow', () => show(null));
  });
</script>
