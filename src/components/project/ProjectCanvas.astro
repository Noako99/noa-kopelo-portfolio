---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import VimeoEmbed from '@components/project/VimeoEmbed.astro';

/* How Figma crops the fill inside the box, in percentages of the box, exactly
   as Figma reports them. Without it an image is shown whole where Figma shows
   a zoomed-in part of it. */
type Crop = { left: number; top: number; w: number; h: number };

type Item = { x: number; y: number; w: number; h: number; depth?: number; lift?: number; rest?: number; grow?: number; crop?: Crop; rotate?: number; group?: string } & (
  | { src: ImageMetadata; alt?: string }
  | { video: string; controls?: boolean; formats?: string[]; slide?: boolean }
  | { vimeo: string; title: string }
  | { color: string; label?: string }
);

interface Props {
  /* The Figma frame this reproduces. Everything below is in its coordinates. */
  width: number;
  height: number;
  /* The frame y that sits at the top of this canvas: the project header
     already draws everything above it, so that band is cut away. */
  offsetY?: number;
  /* Extra room under the last piece, in frame units. */
  tail?: number;
  items: Item[];
}

const { width, height, offsetY = 0, tail = 0, items } = Astro.props;

/* Pieces drift at slightly different speeds as the page scrolls, so the
   arrangement has depth instead of moving as one flat sheet. The speed comes
   from where a piece sits in the frame, not from its place in the list, so two
   pieces set side by side in Figma keep their shared line. */
/* A smooth cycle rather than alternating extremes: neighbouring bands move
   at close speeds, so pieces that sit near each other never drift into one
   another. */
const drifts = [0.07, 0.035, -0.02, -0.07, -0.02, 0.035];
const driftFor = (y: number) => drifts[Math.floor(y / 380) % drifts.length];
const bottom = items.length
  ? Math.max(...items.map((i) => i.y + i.h)) + tail
  : height;
const canvasHeight = Math.max(bottom, height ? Math.min(height, bottom) : bottom) - offsetY;
---

<div class="project-canvas" style={`--fw:${width}; --fh:${canvasHeight};`} data-canvas>
  {items.map((item) => (
    <div
      class="item"
      class:list={[{ sized: item.rest != null, turned: !!item.rotate }]}
      style={`--x:${item.x}; --y:${item.y - offsetY}; --w:${item.w}; --h:${item.h};${item.lift ? ` --z:${item.lift};` : ''}${item.rest != null ? ` --rest:${item.rest}; --grow:${item.grow ?? 1};` : ''}${item.rotate ? ` --turn:${item.rotate}deg;` : ''}`}
      data-drift={item.depth ?? driftFor(item.y)}
      data-auto={item.depth == null ? '' : undefined}
      data-group={item.group}
    >
      {'vimeo' in item ? (
        <VimeoEmbed id={item.vimeo} title={item.title} />
      ) : 'video' in item ? (
        'slide' in item && item.slide ? (
          <span class="slide" data-slide>
            <video autoplay muted loop playsinline preload="metadata" controls={item.controls}>
              {(item.formats ?? ['webm', 'mp4']).map((format) => (
                <source src={`${item.video}.${format}`} type={`video/${format}`} />
              ))}
            </video>
          </span>
        ) : (
        <video autoplay muted loop playsinline preload="metadata" controls={item.controls}>
          {(item.formats ?? ['webm', 'mp4']).map((format) => (
            <source src={`${item.video}.${format}`} type={`video/${format}`} />
          ))}
        </video>
        )
      ) : 'color' in item ? (
        <span class="swatch" style={`background:${item.color}`}>
          {item.label && <span class="swatch-label">{item.label}</span>}
        </span>
      ) : 'crop' in item && item.crop ? (
        <span class="crop">
          <Image
            src={item.src}
            alt={item.alt ?? ''}
            widths={[1600]}
            sizes="100vw"
            loading="lazy"
            decoding="async"
            style={`left:${item.crop.left}%; top:${item.crop.top}%; width:${item.crop.w}%; height:${item.crop.h}%;`}
          />
        </span>
      ) : (
        <Image src={item.src} alt={item.alt ?? ''} widths={[1600]} sizes="100vw" loading="lazy" decoding="async" />
      )}
    </div>
  ))}

  <!-- Anything that needs to sit in the frame but isn't a plain piece of
       media: it inherits --ub, so it is placed in the same Figma units. -->
  <slot />
</div>

<style>
  /* The frame reproduced at the page's width: one Figma pixel of the frame is
     100vw / its own width, so the arrangement is exact at any window size and
     always reaches both edges. */
  .project-canvas {
    --ub: calc(100vw / var(--fw));
    position: relative;
    width: 100vw;
    height: calc(var(--fh) * var(--ub));
  }

  .item {
    position: absolute;
    left: calc(var(--x) * var(--ub));
    top: calc(var(--y) * var(--ub));
    width: calc(var(--w) * var(--ub));
    height: calc(var(--h) * var(--ub));
    z-index: var(--z, 0);
    will-change: transform;
  }

  .item :global(img),
  .item video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* A piece Figma turns. The turn goes on the picture, not the piece: the
     piece's own transform is the parallax, and one would overwrite the
     other. The box is the picture's own, unturned, centred where Figma's
     turned bounding box is centred. */
  .item.turned :global(img) {
    transform: rotate(var(--turn));
  }

  /* A piece that rests at the size of the smallest of its group and comes up
     to its own size under the cursor. */
  .item.sized :global(img) {
    transform: scale(var(--rest, 1));
    transition: transform 900ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .item.sized:hover :global(img),
  .item.sized:focus-within :global(img) {
    transform: scale(var(--grow, 1));
  }

  /* A film that slides inside its own frame: the frame keeps its place in the
     column, so no gap moves, and the picture drifts within it. */
  .slide {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .slide video {
    position: absolute;
    left: 0;
    top: -9%;
    width: 100%;
    height: 118%;
    object-fit: contain;
    will-change: transform;
  }

  .crop {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .crop :global(img) {
    position: absolute;
    max-width: none;
    object-fit: fill;
  }

  /* A colour from the project's palette, with its hex sitting under it the way
     Figma sets it. */
  .swatch {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .swatch-label {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: calc(6 * var(--ub));
    font-family: var(--font-body);
    font-weight: 300;
    font-size: calc(16 * var(--ub));
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: var(--color-text);
  }

  /* On a phone the frame is unreadable at this scale, so it unwinds into a
     single column in the order Figma stacks it. */
  @media (max-width: 640px) {
    .project-canvas {
      width: auto;
      height: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
      padding: var(--space-xl) var(--space-lg) 0 var(--content-left);
    }

    .item {
      position: static;
      width: auto;
      height: auto;
      transform: none !important;
    }

    .item :global(img),
    .item video {
      height: auto;
    }

    .crop {
      position: static;
      aspect-ratio: var(--w) / var(--h);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .item {
      transform: none !important;
    }

    .item.sized :global(img) {
      transition: none;
    }
  }
</style>

<script>
  import { onSmoothScroll } from '../../scripts/smoothScroll';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const flat = window.matchMedia('(max-width: 640px)').matches;
  const pieces = [...document.querySelectorAll<HTMLElement>('.project-canvas .item')];

  if (!reduced && !flat && pieces.length) {
    /* The piece's resting middle, measured once off the layout. Reading it
       back off getBoundingClientRect every frame fed each frame's own
       transform into the next one, which is what tore the arrangement apart:
       a piece far down the page was already hundreds of pixels out of place
       before it had been scrolled to at all. */
    let rest: number[] = [];
    /* Pieces that share a `group` take their progress from the group's
       middle, not each from its own, so the group climbs as one rigid block
       and keeps the overlaps the file draws. Measured each on its own, the
       higher pieces of a pile are further along than the lower ones and
       ride further up, and the pile pulls apart by some 40% of its spacing
       even at a single speed. */
    const measure = () => {
      rest = pieces.map((piece) => piece.offsetTop + piece.offsetHeight / 2);
      const spans = new Map<string, [number, number]>();
      pieces.forEach((piece) => {
        const g = piece.dataset.group;
        if (!g) return;
        const [top, bottom] = spans.get(g) ?? [Infinity, -Infinity];
        spans.set(g, [Math.min(top, piece.offsetTop), Math.max(bottom, piece.offsetTop + piece.offsetHeight)]);
      });
      pieces.forEach((piece, i) => {
        const span = piece.dataset.group ? spans.get(piece.dataset.group) : null;
        if (span) rest[i] = (span[0] + span[1]) / 2;
      });
    };

    /* TRAVEL is how far a piece of depth 1 rides over its whole pass, so
       `depth` reads as a fraction of it. It is 1.9 windows tall — it was a
       fixed 700px, which on a big screen barely moved anything, then 1.4,
       and she asked for more — so the layers part hard. The pieces left to the default cycle move
       3x their listed drift for the same reason; the ones given an explicit
       depth (04's pile, 07's laptops) were already tuned against each other
       and keep their proportions.
       The run is laid out at its Figma spacing and every piece starts there,
       because progress is 0 until the piece is near the window — the gaps
       are the ones the file draws, and the pile closes as it is scrolled
       rather than arriving pre-collapsed. */
    const AUTO = 3;

    const canvas = pieces[0].offsetParent as HTMLElement;

    /* How far piece i stands off its layout place with the page scrolled to
       y: negative is up. */
    const shift = (i: number, y: number, canvasTop: number) => {
      const piece = pieces[i];
      const drift = parseFloat(piece.dataset.drift || '0') * (piece.hasAttribute('data-auto') ? AUTO : 1);
      if (!drift) return 0;
      const travel = window.innerHeight * 1.9;
      const reach = window.innerHeight * 0.9;
      /* -1 well below the window, 0 at its middle, +1 well above it. */
      const away = canvasTop + rest[i] - y - window.innerHeight / 2;
      const progress = Math.max(0, Math.min(1, (reach - away) / (2 * reach)));
      return -drift * travel * progress;
    };

    /* Drawn from the eased scroll position, so the pieces glide after the
       scroll and settle instead of stepping with the wheel. */
    const draw = (y: number) => {
      const canvasTop = canvas.getBoundingClientRect().top + window.scrollY;
      for (let i = 0; i < pieces.length; i++) {
        pieces[i].style.transform = `translate3d(0, ${shift(i, y, canvasTop).toFixed(1)}px, 0)`;
      }
    };

    /* The canvas ends where its pieces are seen to end with the page at the
       bottom — not where the layout puts them. By then the parallax has
       lifted the last pieces well up, and the fixed tail under them left a
       different stretch of empty page on every project before PREV / NEXT.
       Shortening the canvas moves the bottom of the page, which moves where
       the pieces rest there — by about two thirds as much again for the
       fastest pieces — so taking the new height outright overshoots back and
       forth, and at this strength eight such passes still left 04 29px out.
       Each pass therefore goes 60% of the way, which settles in a handful. */
    const fit = () => {
      for (let pass = 0; pass < 30; pass++) {
        const canvasTop = canvas.getBoundingClientRect().top + window.scrollY;
        /* The page's foot is where its last laid-out block ends — the pager
           when there is one. Not scrollHeight: that also counts pieces still
           hanging below before they have risen, and so ran long. */
        const last = document.querySelector<HTMLElement>('.pager') ?? canvas;
        const bottomY = last.getBoundingClientRect().bottom + window.scrollY - window.innerHeight;
        let seen = -Infinity;
        for (let i = 0; i < pieces.length; i++) {
          const piece = pieces[i];
          seen = Math.max(seen, piece.offsetTop + piece.offsetHeight + shift(i, bottomY, canvasTop));
        }
        /* Fractional: offsetHeight rounds, and the last steps are small. */
        const now = canvas.getBoundingClientRect().height;
        if (Math.abs(seen - now) < 0.5) break;
        canvas.style.height = `${(now + (seen - now) * 0.6).toFixed(1)}px`;
      }
    };

    addEventListener('resize', () => {
      measure();
      fit();
    });
    measure();
    fit();
    onSmoothScroll(draw);
  }

  /* The films that slide inside their frames. */
  const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];

  if (!reduced && !flat && slides.length) {
    const move = (y: number) => {
      const middle = window.innerHeight / 2;
      /* The eased position trails the real one; the frames are measured at
         the real one, so shift them by the difference. */
      const lag = window.scrollY - y;
      for (const slide of slides) {
        const real = slide.getBoundingClientRect();
        const box = { top: real.top + lag, bottom: real.bottom + lag, height: real.height };
        if (box.bottom < -200 || box.top > window.innerHeight + 200) continue;
        /* -1 well below the middle, +1 well above it. */
        const away = (middle - (box.top + box.height / 2)) / (window.innerHeight / 2 + box.height / 2);
        const film = slide.firstElementChild as HTMLElement | null;
        if (film) film.style.transform = `translate3d(0, ${(Math.max(-1, Math.min(1, away)) * box.height * 0.09).toFixed(1)}px, 0)`;
      }
    };

    onSmoothScroll(move);
  }

  /* Films start themselves when they come into view and stop when they leave.
     Autoplay only gets past the browser while the track is muted, so it is
     re-asserted here; the controls are there to turn the sound on. */
  /* Only the canvas's own pieces — anything slotted in brings its own. */
  const films = document.querySelectorAll<HTMLVideoElement>('.project-canvas > .item video[autoplay]');

  if (films.length) {
    const watch = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const film = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (!film.hasAttribute('data-unmuted')) film.muted = true;
            film.play().catch(() => {});
          } else {
            film.pause();
          }
        }
      },
      { threshold: 0.25 }
    );

    for (const film of films) {
      watch.observe(film);
      /* Once a viewer turns the sound on, leave it on. */
      film.addEventListener('volumechange', () => {
        if (film.muted) film.removeAttribute('data-unmuted');
        else film.setAttribute('data-unmuted', '');
      });
    }
  }
</script>
