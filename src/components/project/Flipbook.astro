---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/* The booklet, browsed a spread at a time — the "Component 1" Noa built in
   Figma, whose variants are the spreads and whose two rotated squares are the
   arrows sitting at 5.8% and 93.54% across, a little below the middle. */
interface Props {
  spreads: ImageMetadata[];
  alt?: string;
  label?: string;
}

const { spreads, alt = 'Booklet spread', label = 'Booklet' } = Astro.props;
---

<div class="flipbook" data-flipbook aria-roledescription="carousel" aria-label={label}>
  <div class="stage">
    {spreads.map((spread, i) => (
      <figure class="spread" data-index={i} aria-hidden={i === 0 ? 'false' : 'true'}>
        <Image src={spread} alt={`${alt} ${i + 1}`} widths={[1800]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
      </figure>
    ))}
  </div>

  <button class="arrow prev" type="button" data-prev aria-label="Previous spread">
    <span class="mark"></span>
  </button>
  <button class="arrow next" type="button" data-next aria-label="Next spread">
    <span class="mark"></span>
  </button>

  <p class="count"><span data-current>1</span> / {spreads.length}</p>
</div>

<style>
  .flipbook {
    position: absolute;
    inset: 0;
  }

  /* Figma seats the spread between the two marks: 10.3% in from the left,
     6.4% from the right. */
  .stage {
    position: absolute;
    inset: 0 6.4% 0 10.3%;
  }

  .spread {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 260ms ease, visibility 0s linear 260ms;
  }

  .spread[aria-hidden='false'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 260ms ease;
  }

  .spread :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Figma keeps the two marks in the margins beside the spread, a little below
     the middle — here that is just outside the spread's own box. */
  .arrow {
    position: absolute;
    top: 46%;
    width: 4.4%;
    aspect-ratio: 1;
    transform: translateY(-50%);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .prev {
    left: 5.8%;
  }

  .next {
    right: 1.9%;
  }

  /* A square turned on its corner with two sides drawn: Figma's own chevron. */
  .mark {
    width: 62%;
    height: 62%;
    border: 2px solid var(--color-accent);
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .prev .mark {
    border-width: 2px 0 0 2px;
    transform: rotate(-45deg);
  }

  .next .mark {
    border-width: 2px 2px 0 0;
    transform: rotate(45deg);
  }

  .arrow:hover .mark {
    opacity: 0.55;
  }

  .count {
    position: absolute;
    left: 10.3%;
    right: 6.4%;
    top: calc(100% + 0.5rem);
    margin: 0;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(0.65rem, 0.9vw, 0.85rem);
    letter-spacing: 0.18em;
    color: var(--color-text);
    opacity: 0.55;
  }

  @media (max-width: 640px) {
    .flipbook {
      position: relative;
      inset: auto;
      aspect-ratio: 4961 / 3508;
    }
  }
</style>

<script>
  for (const book of document.querySelectorAll<HTMLElement>('[data-flipbook]')) {
    const spreads = [...book.querySelectorAll<HTMLElement>('.spread')];
    const prev = book.querySelector<HTMLButtonElement>('[data-prev]');
    const next = book.querySelector<HTMLButtonElement>('[data-next]');
    const readout = book.querySelector<HTMLElement>('[data-current]');
    if (!spreads.length || !prev || !next) continue;

    let at = 0;

    const show = (i: number) => {
      /* A carousel: past the last spread it comes round to the first. */
      const count = spreads.length;
      at = ((i % count) + count) % count;
      spreads.forEach((s, n) => s.setAttribute('aria-hidden', n === at ? 'false' : 'true'));
      if (readout) readout.textContent = String(at + 1);

      /* Keep the spreads on either side in hand, so a turn is instant. */
      for (const n of [(at + 1) % count, (at - 1 + count) % count]) {
        const img = spreads[n]?.querySelector('img');
        if (img) img.loading = 'eager';
      }
    };

    prev.addEventListener('click', () => show(at - 1));
    next.addEventListener('click', () => show(at + 1));

    /* The arrow keys turn the page while the booklet has focus. */
    book.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
    });

    show(0);
  }
</script>
