---
import Nav from '@components/layout/Nav.astro';
import ProjectTags from '@components/project/ProjectTags.astro';
import logoMark from '@assets/shared/logo-mark.svg';
import { projectTags } from '@config/tags';
import { projectLayout } from '@config/layout';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/* How Figma crops the fill inside the box, and how far the box itself is
   turned, both taken straight from the design. */
type Crop = { left: number; top: number; w: number; h: number };

/* `m` places a piece by hand on the phone, in the 402-wide phone frame, from
   the top of the collage; its height follows its own shape. Pages whose
   pieces sit too far apart on the desktop frame to scale down as one use it. */
type Mobile = { x: number; y: number; w: number };

type Base = { x: number; y: number; w: number; h: number; crop?: Crop; rotate?: number; m?: Mobile };

type Stay =
  | ({ src: ImageMetadata } & Base)
  | ({ video: string } & Base)
  | ({ flipbook: true } & Base)
  | ({ phone: true } & Base);

interface Props {
  slug: string;
  number: string;
  title: string;
  description: string;
  /* The pieces the Figma project frame keeps on screen beside the text. */
  stays?: Stay[];
  /* Taller than the 982 fold when a piece runs past it; the page then scrolls
     rather than clipping. */
  frameHeight?: number;
}

const { slug, number, title, description, stays = [], frameHeight = 982 } = Astro.props;
const { title: titleBox, desc } = projectLayout[slug];
const home = import.meta.env.BASE_URL;

/* On a phone the pieces kept beside the text become one small collage: the
   same arrangement, overlaps and turns as the frame draws them, scaled as a
   whole to the phone's 362-wide column (its 402 less the 20 margins) and
   never taller than 440 — turned pieces then keep inside the margins — and
   centred. All in the phone frame's own units. */
const collage = (() => {
  if (!stays.length) return null;
  if (stays.every((s) => s.m)) {
    return { x0: 0, y0: 0, sc: 0, left: 0, height: Math.max(...stays.map((s) => s.m!.y + (s.m!.w * s.h) / s.w)) };
  }
  const x0 = Math.min(...stays.map((s) => s.x));
  const y0 = Math.min(...stays.map((s) => s.y));
  const bw = Math.max(...stays.map((s) => s.x + s.w)) - x0;
  const bh = Math.max(...stays.map((s) => s.y + s.h)) - y0;
  /* Turned pieces swing their corners past their boxes (05's book is turned
     13°); 0.84 of the size keeps those corners inside the margins too. */
  const sc = Math.min(362 / bw, 440 / bh) * (stays.some((s) => s.rotate) ? 0.84 : 1);
  return { x0, y0, sc, left: (402 - bw * sc) / 2, height: bh * sc };
})();
/* Phone frame: the bar at 35, the name at 80, then the collage, then the
   number, title and description. The tags go to the foot of the page. */
const M_NAME = 80;
const M_COLLAGE = 176;
/* A flip-through hangs its page count under its box. */
const hangs = stays.some((s) => 'flipbook' in s) ? 40 : 0;
const mTextTop = collage ? M_COLLAGE + collage.height + 36 + hangs : M_COLLAGE;
---

<div class="canvas-wrap" class:list={[{ tall: frameHeight > 982 }]} style={`--fh:${frameHeight};`}>
  <ProjectTags tags={projectTags[slug]} name={`tags-${slug}`} />

  <div
    class="canvas"
    style={collage ? `--mx0:${collage.x0}; --my0:${collage.y0}; --msc:${collage.sc}; --mleft:${collage.left}; --mcol:${M_COLLAGE}; --mname:${M_NAME}; --mtext:${mTextTop};` : `--mname:${M_NAME}; --mtext:${mTextTop};`}
  >
    <Nav canvas />

    {stays.map((stay) => (
      <div
        class="stay"
        class:list={[{ turned: !!stay.rotate, plain: 'flipbook' in stay || 'phone' in stay }]}
        data-m={stay.m ? '' : undefined}
        style={`--x:${stay.x}; --y:${stay.y}; --w:${stay.w}; --h:${stay.h};${stay.rotate ? ` --turn:${stay.rotate}deg;` : ''}${stay.m ? ` --smx:${stay.m.x}; --smy:${stay.m.y}; --smw:${stay.m.w};` : ''}`}
      >
        {'video' in stay ? (
          <video autoplay muted loop playsinline preload="metadata">
            <source src={`${stay.video}.webm`} type="video/webm" />
            <source src={`${stay.video}.mp4`} type="video/mp4" />
          </video>
        ) : 'flipbook' in stay ? (
          <slot name="flipbook" />
        ) : 'phone' in stay ? (
          <slot name="phone" />
        ) : stay.crop ? (
          <span class="crop">
            <Image
              src={stay.src}
              alt=""
              widths={[960, 1600]}
              loading="eager"
              style={`left:${stay.crop.left}%; top:${stay.crop.top}%; width:${stay.crop.w}%; height:${stay.crop.h}%;`}
            />
          </span>
        ) : (
          <Image src={stay.src} alt="" widths={[600, 960]} loading="eager" />
        )}
      </div>
    ))}

    <a class="name" href={home} style="view-transition-name: site-name">Noa Kopelo</a>

    <!-- The description runs on under the title, in the same block, so the gap
         between them is the same on every page however many lines the title
         takes. -->
    <div class="project-head" style={`--x:${titleBox.x}; --y:${titleBox.y};`}>
      <div class="project-title" data-slug={slug} style={`--w:${titleBox.w};`}>
        <span class="num" style={`view-transition-name: num-${slug}`}>{number}</span>
        <span class="title" style={`view-transition-name: title-${slug}`}>{title}</span>
      </div>

      <p class="description" style={`--w:${desc.w};`}>{description}</p>

      <!-- There is more below: 35 under the paragraph, on its left edge. -->
      <svg class="scroll-cue" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <path d="M0.353267 12.208L12.5614 24.4161L24.7695 12.208M12.5614 24.4161L12.5614 -0.000125067" />
      </svg>
    </div>

    <!-- The mark keeps the corner it has on the home page, 47,915, rather than
         standing beside the name. There is no OPEN FOR COLLAB here.
         It carries the same face as the home page: eyes at (12,17) and (18,17)
         with radius 1, and an 8-wide smile from (11,21). It stays on that spot
         as the page scrolls, and takes you back home. -->
    <a class="brand-mark" href={home} aria-label="Back to the home page" style="view-transition-name: site-mark">
      <img src={logoMark.src} alt="" />
      <svg class="mark-face" viewBox="0 0 30 28" aria-hidden="true">
        <circle cx="12" cy="17" r="1" />
        <circle cx="18" cy="17" r="1" />
        <path d="M 11 21 C 12.185 22.509 15.444 24.622 19 21" />
      </svg>
    </a>
  </div>
</div>

<style>
  /* The same frame the homepage draws, so nothing jumps on the way in: the
     project holds the place it had in the list and the other six are gone. */
  .canvas-wrap {
    /* --u fits the frame to the window; --ux spreads it across the width —
       see the home page's .canvas-wrap for the whole story. */
    --u: min(calc(100vw / 1728), calc(100vh / 982));
    --ux: calc(100cqw / 1728);
    container-type: inline-size;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: var(--color-bg);
  }

  .canvas {
    position: relative;
    flex: none;
    width: 100%;
    height: calc(982 * var(--u));
  }

  /* A frame with something running past the fold: the page scrolls to it
     instead of the wrap cutting it off, and the top keeps the position it has
     on every other project page. */
  .canvas-wrap.tall {
    height: auto;
    min-height: 100vh;
    overflow: visible;
    align-items: flex-start;
    padding-top: max(0px, calc((100vh - 982 * var(--u)) / 2));
  }

  .canvas-wrap.tall .canvas {
    height: calc(var(--fh) * var(--u));
  }

  /* The tag row is placed at 50% of the wrap, which is the frame's own middle
     on every other page. A tall wrap is no longer 982 high, so 50% falls far
     down it. Here the row is measured from the top of the canvas instead —
     the wrap's padding plus the same --tag-top every other page uses, so it
     lands on the CV baseline. (It read 35 here, which is CV's box, not the
     tag's, and put the red 4 units above CV on 03.) */
  .canvas-wrap.tall :global(.project-tags) {
    top: calc(max(0px, (100vh - 982 * var(--u)) / 2) + var(--tag-top) * var(--u));
  }

  /* Figma: 260,198, 371 wide — centred on 445.5, never wrapping. */
  .name {
    position: absolute;
    left: calc(445.5 * var(--ux));
    top: calc(198 * var(--u));
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: calc(80 * var(--u));
    line-height: 1.35;
    letter-spacing: -0.07em;
    text-align: center;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  /* It leads home, and turns the accent red under the cursor to say so. */
  .name:hover,
  .name:focus-visible {
    color: var(--color-accent);
  }

  .stay {
    position: absolute;
    left: calc(var(--x) * var(--ux));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    overflow: hidden;
  }

  /* A piece Figma turns on the page. */
  .stay.turned {
    transform: rotate(var(--turn));
  }

  /* A slot that brings its own chrome — nothing is clipped off it. */
  .stay.plain {
    overflow: visible;
  }

  /* A fill Figma crops: the window is the box, the picture is placed inside it
     at the scale and offset Figma gives. */
  .crop {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .crop :global(img) {
    position: absolute;
    max-width: none;
    object-fit: fill;
  }

  .stay :global(img),
  .stay video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Stands where the project stood in the home page list. */
  .project-head {
    position: absolute;
    left: calc(var(--x) * var(--ux));
    top: calc(var(--y) * var(--u));
  }

  .project-title {
    width: calc(var(--w) * var(--u));
  }

  /* Figma: 18px, -1.26px tracking — set to -0.72px (-0.04em) at her ask.
     Regular on the project page, at her ask; the home list keeps its own. */
  .num {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: calc(18 * var(--u));
    letter-spacing: -0.04em;
    color: var(--color-accent);
  }

  /* One line each, as the file sets them — see the same pair on the home page. */
  .project-title[data-slug='noa-atalia'] .title,
  .project-title[data-slug='3-generations'] .title {
    white-space: nowrap;
  }

  /* Medium on the project page, at her ask. */
  .title {
    display: block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: calc(18 * var(--u));
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  /* Figma: General Sans Regular 18px, 3.6px tracking, uppercase. The +3.6 on the
     width offsets the trailing letter-space CSS adds and Figma does not. */
  /* 24 under the title's last line on every page. It was 50 until the
     arrow went in under the paragraph: on 05 and 06, the lowest titles, the
     arrow then ended at 1001, past the 982 fold. At 24 it ends at 975. */
  .description {
    width: calc((var(--w) + 3.6) * var(--u));
    margin: calc(24 * var(--u)) 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: calc(18 * var(--u));
    letter-spacing: 0.2em;
    text-transform: uppercase;
    /* Figma sets this block 334 tall; at 1.375 it ran to 402 and fell past
       the fold. */
    line-height: 1.24;
    color: var(--color-text);
  }

  /* Pinned to the window at the spot it has in the frame, so it rides down
     with the scroll instead of leaving with the first screen. The canvas is
     pinned to the window's left edge and centred in its height, so 47,915 in
     the frame is 47u from the left and 50vh + (915 - 491)u from the top. The
     tall pages pad the canvas by that same half, so it holds there too. */
  /* 26 x 26 in the file, drawn in the accent red with a hairline stroke. */
  .scroll-cue {
    display: block;
    width: calc(26 * var(--u));
    height: calc(26 * var(--u));
    margin-top: calc(35 * var(--u));
    overflow: visible;
  }

  .scroll-cue path {
    stroke: var(--color-accent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .brand-mark {
    position: fixed;
    z-index: 100;
    left: calc(47 * var(--ux));
    top: calc(50vh + (915 - 491) * var(--u));
    width: calc(30 * var(--u));
    height: calc(28 * var(--u));
    display: block;
    transform-origin: 50% 100%;
  }

  .brand-mark img,
  .mark-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The face sits in the gap between the arch's legs, where the page's own
     background shows through, so it is drawn in the same red as the mark. */
  .mark-face {
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .mark-face circle {
    fill: var(--color-accent);
  }

  .mark-face path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    stroke-linecap: round;
  }

  /* The same greeting as the home page: hovering the name — or the mark —
     rocks it on its own base and brings up the face. */
  .canvas:has(.name:hover) .brand-mark,
  .canvas:has(.name:focus-visible) .brand-mark,
  .brand-mark:hover {
    animation: mark-sway 2.4s ease-in-out infinite;
  }

  .canvas:has(.name:hover) .mark-face,
  .canvas:has(.name:focus-visible) .mark-face,
  .brand-mark:hover .mark-face {
    opacity: 1;
  }

  @keyframes mark-sway {
    0%,
    100% {
      transform: rotate(-5deg);
    }
    50% {
      transform: rotate(5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .canvas:has(.name:hover) .brand-mark,
    .canvas:has(.name:focus-visible) .brand-mark,
    .brand-mark:hover {
      animation: none;
    }
  }

  /* ===== PHONE =====
     Drawn on a 390-wide frame (--m is one of its pixels), everything on the
     20 margins: the bar and the tags across the top, the name, the collage
     of the pieces kept beside the text, then the number, title, description
     and arrow, left-aligned in one column. */
  @media (max-width: 640px) {
    .canvas-wrap,
    .canvas-wrap.tall {
      display: block;
      width: auto;
      height: auto;
      min-height: 0;
      padding-top: 0;
      overflow: visible;
    }

    /* On a phone the tag row closes the page instead (see ProjectPager). */
    .canvas-wrap :global(.project-tags) {
      display: none;
    }

    .canvas,
    .canvas-wrap.tall .canvas {
      width: auto;
      height: auto;
      padding: calc(var(--mtext) * var(--m)) calc(20 * var(--m)) calc(24 * var(--m));
    }

    .name {
      left: calc(20 * var(--m));
      top: calc(var(--mname) * var(--m));
      transform: none;
      font-size: calc(58 * var(--m));
      text-align: left;
    }

    /* Each piece at its place in the frame, the whole scaled as one. */
    .stay {
      left: calc((var(--mleft) + (var(--x) - var(--mx0)) * var(--msc)) * var(--m));
      top: calc((var(--mcol) + (var(--y) - var(--my0)) * var(--msc)) * var(--m));
      width: calc(var(--w) * var(--msc) * var(--m));
      height: calc(var(--h) * var(--msc) * var(--m));
    }

    .stay[data-m] {
      left: calc(var(--smx) * var(--m));
      top: calc((var(--mcol) + var(--smy)) * var(--m));
      width: calc(var(--smw) * var(--m));
      height: calc(var(--smw) * var(--h) / var(--w) * var(--m));
    }

    .project-head {
      position: static;
    }

    .project-title {
      width: auto;
    }

    .num,
    .title {
      font-size: calc(14 * var(--m));
    }

    .description {
      width: auto;
      margin-top: calc(14 * var(--m));
      font-size: calc(12 * var(--m));
      letter-spacing: 0.16em;
      line-height: 1.4;
    }

    /* A phone is scrolled anyway; the arrow is a desktop's hint. */
    .scroll-cue {
      display: none;
    }

    /* Pinned in a corner it would sit on the text of a phone's narrow
       column, so here it takes the middle of the top bar, between CV and
       CONTACT, and scrolls away with it — still the way home. */
    .brand-mark {
      position: absolute;
      left: calc(50% - 15 * var(--m));
      top: calc(34 * var(--m));
      width: calc(30 * var(--m));
      height: calc(28 * var(--m));
    }
  }
</style>
