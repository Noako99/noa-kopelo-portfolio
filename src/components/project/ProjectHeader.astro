---
import logoMark from '@assets/shared/logo-mark.svg';

interface Props {
  number: string;
  title: string;
  description: string;
  tags: string[];
}

const { number, title, description, tags } = Astro.props;
---

<header class="project-header">
  <ul class="tags-row" role="list">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <a href={import.meta.env.BASE_URL} class="brand">
    Noa Kopelo
    <img src={logoMark.src} alt="" class="brand-mark" />
  </a>

  <div class="meta">
    <p class="kicker">{number}</p>
    <h1>{title}</h1>
  </div>

  <p class="description">{description}</p>
</header>

<style>
  .project-header {
    padding: 9.5rem var(--space-lg) var(--space-2xl);
    max-width: var(--max-width);
    margin-inline: auto;
    position: relative;
  }

  .tags-row {
    position: absolute;
    top: 2.2rem;
    right: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags-row li {
    font-family: var(--font-label);
    font-weight: 300;
    font-size: 0.85rem;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.75rem, 7vw, 5rem);
    letter-spacing: -0.07em;
    color: var(--color-text);
    text-align: center;
  }

  .brand-mark {
    width: clamp(1rem, 2vw, 1.5rem);
    height: auto;
  }

  .meta {
    margin-top: var(--space-2xl);
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .kicker {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: 1.15rem;
    color: var(--color-accent);
  }

  .meta h1 {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .description {
    margin-top: var(--space-md);
    max-width: 24rem;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .project-header {
      padding-top: 6rem;
    }

    .tags-row {
      position: static;
      margin-bottom: var(--space-lg);
      gap: 0.75rem 1rem;
    }
  }
</style>
