---
/* The project's film, set down on its own stage. As the page is scrolled it
   rises out of the fold, growing from 0.8 as it comes, while the title and the
   text leave the screen above it; it lands dead centre with nothing else on
   the glass, and the page settles onto that spot if the scroll stops near it —
   the film clicks into place. It holds there, playing, for a stretch of
   scroll, then goes on up with the page. It is paused until it lands and
   paused again once it has gone. */
interface Props {
  /* Share of the window height the film may take once it has landed. */
  height?: number;
  /* How long it holds in the centre, as a share of the window height. */
  dwell?: number;
}

const { height = 0.8, dwell = 0.7 } = Astro.props;
---

<section class="stage" style={`--h:${height}; --dwell:${dwell};`} data-stage>
  <div class="pin">
    <div class="inner">
      <slot />
    </div>
  </div>
</section>

<style>
  /* One window to land in, plus the hold. The pin sticks to the top of the
     window for exactly the length of the hold. */
  .stage {
    position: relative;
    height: calc((1 + var(--dwell)) * 100vh);
    /* The landing spot: the stage's top on the window's top puts the film in
       the middle of an otherwise empty screen. */
    scroll-snap-align: start;
  }

  .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The page's width less the Figma margin on each side. The scale is driven
     from the script as the film rises, so it arrives rather than just
     appears. */
  .inner {
    width: calc(100vw - 2 * 81 * var(--u));
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* Proportional to the window, never edge to edge: the film keeps its own
     shape and is capped at a share of the window height, so it lands with
     empty page all round it. */
  .inner :global(img),
  .inner :global(video),
  .inner :global(.frame) {
    max-height: calc(var(--h) * 100vh);
    margin-inline: auto;
  }

  .inner :global(.frame) {
    /* A 16:9 box tall enough to respect the cap, centred in the column. */
    max-width: calc(var(--h) * 100vh * 16 / 9);
  }

  .inner :global(img),
  .inner :global(video) {
    width: auto;
    max-width: 100%;
    display: block;
  }

  /* Only these pages settle onto the film; everywhere else scrolls freely.
     Proximity, not mandatory: it only takes hold when the scroll comes to rest
     near the spot. */
  :global(html:has([data-stage])) {
    scroll-snap-type: y proximity;
  }

  @media (max-width: 640px) {
    .stage {
      height: auto;
      margin: var(--space-xl) var(--space-lg) 0 var(--content-left);
      scroll-snap-align: none;
    }

    .pin {
      position: static;
      height: auto;
      display: block;
    }

    .inner {
      width: auto;
      transform: none !important;
    }

    .inner :global(img),
    .inner :global(video),
    .inner :global(.frame) {
      max-height: none;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inner {
      transform: none !important;
    }
  }
</style>

<script>
  import { onSmoothScroll } from '../../scripts/smoothScroll';

  const stages = [...document.querySelectorAll<HTMLElement>('[data-stage]')];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Vimeo's player takes its orders by message. */
  const tell = (frame: HTMLIFrameElement, method: 'play' | 'pause') =>
    frame.contentWindow?.postMessage(JSON.stringify({ method }), 'https://player.vimeo.com');

  if (stages.length) {
    /* The growth is drawn from the eased scroll position, so it swells and
       settles rather than stepping with the wheel; whether it plays follows
       the real one. */
    const grow = (y: number) => {
      if (reduced) return;
      const vh = window.innerHeight;
      const lag = window.scrollY - y;
      for (const stage of stages) {
        const top = stage.getBoundingClientRect().top + lag;
        const inner = stage.querySelector<HTMLElement>('.inner');
        /* 0 while the stage waits below the fold, 1 once it has landed. It
           grows from 0.8 on an ease-out, so most of the growing is done early
           and the last stretch before the landing is calm. */
        const rise = Math.min(1, Math.max(0, 1 - top / vh));
        const eased = 1 - Math.pow(1 - rise, 3);
        if (inner) inner.style.transform = `scale(${(0.8 + 0.2 * eased).toFixed(4)})`;
      }
    };

    let ticking = false;

    const frame = () => {
      ticking = false;
      const vh = window.innerHeight;

      for (const stage of stages) {
        const top = stage.getBoundingClientRect().top;

        /* Playing from the moment it has all but landed until it has mostly
           gone up past the top. */
        const holdEnd = -(stage.offsetHeight - vh);
        const playing = top < vh * 0.12 && top > holdEnd - vh * 0.5;
        if (stage.dataset.playing === String(playing)) continue;
        stage.dataset.playing = String(playing);

        stage.querySelectorAll('video').forEach((video) => {
          if (playing) {
            video.muted = true;
            void video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
        stage.querySelectorAll<HTMLIFrameElement>('iframe[src*="vimeo"]').forEach((f) =>
          tell(f, playing ? 'play' : 'pause')
        );
      }
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(frame);
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    /* A Vimeo player that has only just loaded missed the first order. */
    stages.forEach((stage) =>
      stage.querySelectorAll('iframe').forEach((f) =>
        f.addEventListener('load', () => {
          delete stage.dataset.playing;
          onScroll();
        })
      )
    );
    frame();
    onSmoothScroll(grow);
  }
</script>
