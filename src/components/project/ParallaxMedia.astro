---
/* The project's film, set down on its own stage. As the page is scrolled it
   rises out of the fold, growing from 0.7 as it comes, while the title and the
   text leave the screen above it; it lands dead centre with nothing else on
   the glass, and the page settles onto that spot if the scroll stops near it —
   the film clicks into place. It holds there, playing, for a stretch of
   scroll, then goes on up with the page. It is paused until it lands and
   paused again once it has gone. */
interface Props {
  /* Share of the window height the film may take once it has landed. */
  height?: number;
  /* How long it holds in the centre, as a share of the window height. */
  dwell?: number;
  /* The film is the last thing on the page (01, 02). */
  last?: boolean;
}

const { height = 0.8, dwell = 0.7, last = false } = Astro.props;
---

<section class="stage" class:list={[{ last }]} style={`--h:${height}; --dwell:${dwell};`} data-stage>
  <div class="pin">
    <div class="inner">
      <slot />
    </div>
  </div>
</section>

<style>
  /* One window to land in, plus the hold. The pin sticks to the top of the
     window for exactly the length of the hold. */
  .stage {
    position: relative;
    height: calc((1 + var(--dwell)) * 100vh);
  }

  /* When the film is the last thing on the page, what follows (PREV / NEXT)
     comes up past the empty band the pin leaves under it, so it sits under
     the film itself. The band is half of whatever the film leaves of the
     window's height — a wide film leaves more than its cap — so the script
     measures it; this is only the first guess. */
  .stage.last {
    margin-bottom: calc(-1 * (1 - var(--h)) * 50vh);
  }

  .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The page's width less the Figma margin on each side. The scale is driven
     from the script as the film rises, so it arrives rather than just
     appears. */
  .inner {
    width: calc(100vw - 2 * 81 * var(--u));
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* Proportional to the window, never edge to edge: the film keeps its own
     shape and is capped at a share of the window height, so it lands with
     empty page all round it. */
  .inner :global(img),
  .inner :global(video),
  .inner :global(.frame) {
    max-height: calc(var(--h) * 100vh);
    margin-inline: auto;
  }

  .inner :global(.frame) {
    /* A 16:9 box tall enough to respect the cap, centred in the column. */
    max-width: calc(var(--h) * 100vh * 16 / 9);
  }

  .inner :global(img),
  .inner :global(video) {
    width: auto;
    max-width: 100%;
    display: block;
  }

  @media (max-width: 640px) {
    /* The column's 20 margins, like everything else on a phone. */
    .stage,
    .stage.last {
      height: auto;
      margin: calc(40 * var(--m)) calc(20 * var(--m)) 0;
    }

    .pin {
      position: static;
      height: auto;
      display: block;
    }

    .inner {
      width: auto;
      transform: none !important;
    }

    .inner :global(img),
    .inner :global(video),
    .inner :global(.frame) {
      max-height: none;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inner {
      transform: none !important;
    }
  }
</style>

<script>
  import { onSmoothScroll } from '../../scripts/smoothScroll';

  const stages = [...document.querySelectorAll<HTMLElement>('[data-stage]')];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Vimeo's player takes its orders by message. */
  const tell = (frame: HTMLIFrameElement, method: 'play' | 'pause') =>
    frame.contentWindow?.postMessage(JSON.stringify({ method }), 'https://player.vimeo.com');

  if (stages.length) {
    /* The growth is drawn from the eased scroll position, so it swells and
       settles rather than stepping with the wheel; whether it plays follows
       the real one. */
    const grow = (y: number) => {
      if (reduced) return;
      const vh = window.innerHeight;
      const lag = window.scrollY - y;
      for (const stage of stages) {
        const top = stage.getBoundingClientRect().top + lag;
        const inner = stage.querySelector<HTMLElement>('.inner');
        /* 0 while the stage waits below the fold, 1 once it has landed. It
           grows from 0.7 on an ease-out, so most of the growing is done early
           and the last stretch before the landing is calm. */
        const rise = Math.min(1, Math.max(0, 1 - top / vh));
        const eased = 1 - Math.pow(1 - rise, 3);
        if (inner) inner.style.transform = `scale(${(0.7 + 0.3 * eased).toFixed(4)})`;
      }
    };

    let ticking = false;

    const frame = () => {
      ticking = false;
      const vh = window.innerHeight;

      for (const stage of stages) {
        const top = stage.getBoundingClientRect().top;

        /* Playing from the moment it has all but landed until it has mostly
           gone up past the top. */
        const holdEnd = -(stage.offsetHeight - vh);
        const playing = top < vh * 0.12 && top > holdEnd - vh * 0.5;
        if (stage.dataset.playing === String(playing)) continue;
        stage.dataset.playing = String(playing);

        stage.querySelectorAll('video').forEach((video) => {
          if (playing) {
            video.muted = true;
            void video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
        stage.querySelectorAll<HTMLIFrameElement>('iframe[src*="vimeo"]').forEach((f) =>
          tell(f, playing ? 'play' : 'pause')
        );
      }
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(frame);
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    /* A Vimeo player that has only just loaded missed the first order. */
    stages.forEach((stage) =>
      stage.querySelectorAll('iframe').forEach((f) =>
        f.addEventListener('load', () => {
          delete stage.dataset.playing;
          onScroll();
        })
      )
    );
    frame();
    onSmoothScroll(grow);

    const trim = () => {
      if (window.matchMedia('(max-width: 640px)').matches) return;
      for (const stage of stages) {
        if (!stage.classList.contains('last')) continue;
        const inner = stage.querySelector<HTMLElement>('.inner');
        if (!inner) continue;
        stage.style.marginBottom = `${(-(window.innerHeight - inner.offsetHeight) / 2).toFixed(1)}px`;
      }
    };
    addEventListener('resize', trim);
    /* A <video>'s height is only known once its first frame is. */
    stages.forEach((stage) => stage.querySelectorAll('video').forEach((v) => v.addEventListener('loadedmetadata', trim)));
    trim();

    /* The click into place. The landing spot is the stage's top on the
       window's top: the film in the middle of an otherwise empty screen.
       When a scroll heading down comes to rest just short of it or just past
       it, the page glides the rest of the way. It was CSS scroll snapping,
       but on 01 the page runs only a little further than the landing, so
       from anywhere near the foot the browser counted the film as near and
       dragged the page back up to it. This only takes hold within 12% of a
       window of the spot, and only on the way down, so the rest of the page —
       and the way back up — scroll freely. */
    if (!window.matchMedia('(max-width: 640px)').matches) {
      let lastY = window.scrollY;
      let heading = 0;
      let rest = 0;
      let gliding = false;

      addEventListener(
        'scroll',
        () => {
          const y = window.scrollY;
          if (y !== lastY) heading = Math.sign(y - lastY);
          lastY = y;
          if (gliding) return;
          clearTimeout(rest);
          rest = window.setTimeout(() => {
            if (heading <= 0) return;
            const reach = window.innerHeight * 0.12;
            for (const stage of stages) {
              const landing = stage.getBoundingClientRect().top + window.scrollY;
              const off = window.scrollY - landing;
              if (off !== 0 && Math.abs(off) < reach) {
                gliding = true;
                window.scrollTo({ top: landing, behavior: reduced ? 'auto' : 'smooth' });
                window.setTimeout(() => (gliding = false), 700);
                return;
              }
            }
          }, 140);
        },
        { passive: true }
      );
    }
  }
</script>
