---
/* The motion pieces shown one at a time inside a phone, paged with the same
   two red marks the booklet uses. */
interface Film {
  src: string;
  title: string;
  formats?: string[];
}

interface Props {
  films: Film[];
  label?: string;
}

const { films, label = 'Motion pieces' } = Astro.props;
---

<div class="phone-carousel" data-phone aria-roledescription="carousel" aria-label={label}>
  <div class="phone">
    <div class="screen">
      {films.map((film, i) => (
        <figure class="film" data-index={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <video muted playsinline autoplay={i === 0} preload={i === 0 ? 'auto' : 'metadata'} aria-label={film.title}>
            {(film.formats ?? ['mp4']).map((format) => (
              <source src={`${film.src}.${format}`} type={`video/${format}`} />
            ))}
          </video>
        </figure>
      ))}
    </div>
    <span class="island" aria-hidden="true"></span>
  </div>

  <button class="arrow prev" type="button" data-prev aria-label="Previous piece"><span class="mark"></span></button>
  <button class="arrow next" type="button" data-next aria-label="Next piece"><span class="mark"></span></button>

  <p class="count"><span data-current>1</span> / {films.length}</p>
</div>

<style>
  .phone-carousel {
    position: absolute;
    inset: 0;
  }

  /* The body: 9:19.5, the proportions of a current phone. */
  .phone {
    position: absolute;
    left: 50%;
    top: 0;
    height: 100%;
    aspect-ratio: 9 / 19.5;
    transform: translateX(-50%);
    background: #101012;
    border-radius: 12.5% / 5.8%;
    padding: 1.15%;
    box-shadow:
      0 0 0 0.35% #2b2b30,
      0 calc(1.2 * 1%) calc(3 * 1%) rgba(0, 0, 0, 0.18);
  }

  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 11.4% / 5.3%;
    overflow: hidden;
    background: #000;
  }

  .film {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 320ms ease, visibility 0s linear 320ms;
  }

  .film[aria-hidden='false'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 320ms ease;
  }

  .film video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* The cutout at the top of the screen. */
  .island {
    position: absolute;
    left: 50%;
    top: 3%;
    transform: translateX(-50%);
    width: 30%;
    height: 3.4%;
    border-radius: 999px;
    background: #101012;
  }

  .arrow {
    position: absolute;
    top: 50%;
    width: 17%;
    aspect-ratio: 1;
    transform: translateY(-50%);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  /* Outside the body, so they do not sit on the screen. */
  .prev {
    left: -26%;
  }

  .next {
    right: -26%;
  }

  .mark {
    width: 40%;
    height: 40%;
    border: 2px solid var(--color-accent);
    transition: opacity 160ms ease;
  }

  .prev .mark {
    border-width: 2px 0 0 2px;
    transform: rotate(-45deg);
  }

  .next .mark {
    border-width: 2px 2px 0 0;
    transform: rotate(45deg);
  }

  .arrow:hover .mark {
    opacity: 0.55;
  }

  .count {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 0.9rem);
    margin: 0;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(0.65rem, 0.9vw, 0.85rem);
    letter-spacing: 0.18em;
    color: var(--color-text);
    opacity: 0.55;
  }

  @media (max-width: 640px) {
    .phone-carousel {
      position: relative;
      inset: auto;
      aspect-ratio: 9 / 19.5;
      max-width: 17rem;
      margin-inline: auto;
    }

    .prev {
      left: -14%;
    }

    .next {
      right: -14%;
    }
  }
</style>

<script>
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-phone]')) {
    const films = [...carousel.querySelectorAll<HTMLElement>('.film')];
    const prev = carousel.querySelector<HTMLButtonElement>('[data-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-next]');
    const readout = carousel.querySelector<HTMLElement>('[data-current]');
    if (!films.length || !prev || !next) continue;

    let at = 0;
    let onScreen = false;

    const play = (film: HTMLElement | undefined) => {
      const video = film?.querySelector('video');
      if (!video) return;
      video.muted = true;
      /* If it isn't ready yet, start it the moment it is. */
      if (video.readyState < 2) {
        video.addEventListener(
          'canplay',
          () => {
            if (films[at] === film && onScreen) video.play().catch(() => {});
          },
          { once: true }
        );
      }
      video.play().catch(() => {});
    };

    const show = (i: number) => {
      const count = films.length;
      at = ((i % count) + count) % count;

      films.forEach((film, n) => {
        film.setAttribute('aria-hidden', n === at ? 'false' : 'true');
        const video = film.querySelector('video');
        if (!video) return;
        if (n === at) {
          /* Only the piece on screen is worth downloading. */
          if (video.preload !== 'auto') video.preload = 'auto';
          if (video.currentTime > 0.05) video.currentTime = 0;
          if (onScreen) play(film);
        } else {
          video.pause();
          if (video.currentTime > 0.05) video.currentTime = 0;
        }
      });

      /* The next one up, so a page turn starts straight away. */
      const ahead = films[(at + 1) % count]?.querySelector('video');
      if (ahead && ahead.preload !== 'auto') ahead.preload = 'auto';

      if (readout) readout.textContent = String(at + 1);
    };

    prev.addEventListener('click', () => show(at - 1));
    next.addEventListener('click', () => show(at + 1));

    /* It pages by itself, without stopping: each piece hands over to the next
       when it reaches its end, and after the last one it starts again. */
    films.forEach((film, n) => {
      const video = film.querySelector('video');
      video?.addEventListener('ended', () => {
        if (n === at) show(at + 1);
      });
    });

    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
    });

    /* It runs while it is in view and rests when it is not. Read off the
       position on scroll rather than through an observer, which some surfaces
       never report on. */
    const look = () => {
      const box = carousel.getBoundingClientRect();
      onScreen = box.bottom > window.innerHeight * 0.15 && box.top < window.innerHeight * 0.85;
      const video = films[at]?.querySelector('video');
      if (!video) return;
      /* Asked every time rather than only on a change, so a piece that was
         stopped for any reason picks itself back up. */
      if (onScreen) {
        if (video.paused && !video.ended) play(films[at]);
        /* If it stopped at its end without the handover landing, move on. */
        if (video.ended) show(at + 1);
      } else if (!video.paused) {
        video.pause();
      }
    };

    addEventListener('scroll', look, { passive: true });
    addEventListener('resize', look);
    addEventListener('visibilitychange', look);

    /* A quiet check as well: a browser can stop a film on its own — coming back
       to the tab, or saving power — and nothing would ask it to carry on. */
    setInterval(look, 1200);

    show(0);
    look();
  }
</script>
