---
import BaseHead from '@components/layout/BaseHead.astro';
import 'lenis/dist/lenis.css';
import '../styles/theme.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  /* Optional class for the body element, e.g. "home-fixed" to lock the page to one screen. */
  bodyClass?: string;
}

const { title, description, image, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {title} {description} {image} />
  </head>
  <body class={bodyClass}>
    <main>
      <slot />
    </main>

    <!-- The site's smooth scroll — see scripts/smoothScroll. -->
    <script>
      import { startSmoothScroll } from '../scripts/smoothScroll';
      startSmoothScroll();

      /* Keyboard or pointer, for the focus ring (see theme.css). */
      const root = document.documentElement;
      addEventListener('keydown', (e) => {
        if (e.key === 'Tab') root.classList.add('keys');
      });
      addEventListener('pointerdown', () => root.classList.remove('keys'));
    </script>
  </body>
</html>
