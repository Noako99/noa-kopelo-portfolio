---
import BaseHead from '@components/layout/BaseHead.astro';
import '../styles/theme.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {title} {description} {image} />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
