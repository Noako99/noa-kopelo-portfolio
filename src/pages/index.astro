---
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav.astro';
import ProjectTags from '@components/project/ProjectTags.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '@config/site';
import { projectTags } from '@config/tags';
import logoMark from '@assets/shared/logo-mark.svg';

import noaAtaliaCover from '@assets/projects/noa-atalia/cover.jpg';
import { backdropFor, spotFor } from '@config/projects';
import type { ImageMetadata } from 'astro';

import moreLayer7 from '@assets/projects/more-than-i-love-my-life/layer-71.png';
import moreLayer8 from '@assets/projects/more-than-i-love-my-life/layer-8.png';
import moreLayer14 from '@assets/projects/more-than-i-love-my-life/layer-14.png';
import moreLayer16 from '@assets/projects/more-than-i-love-my-life/layer-16.png';

import building1 from '@assets/projects/3-generations/building-1.png';
import building2 from '@assets/projects/3-generations/building-2.png';
import building3 from '@assets/projects/3-generations/building-3.png';
import building4 from '@assets/projects/3-generations/building-4.png';
import building5 from '@assets/projects/3-generations/building-5.png';
import building6 from '@assets/projects/3-generations/building-6.png';
import building7 from '@assets/projects/3-generations/building-7.png';



const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* Every x / y / w / h below is the literal Figma coordinate, taken from the
   homepage frame (1728×982) and from each matching HOVER frame.

   `bg` bleeds across the whole browser window — it is deliberately NOT bound to
   the scaled canvas, so a hover fills the screen edge to edge on any viewport.
   `cards` stay pinned to the canvas, since their positions only mean anything
   relative to the 1728×982 frame. `mark` is no longer drawn — the arrow sits over the number instead.
   Either a bg or a card may be a looping video instead of a still. */
const projects = [
  {
    slug: 'noa-atalia',
    number: '01',
    title: 'Noa & Atalia',
    href: `${base}/projects/noa-atalia`,
    ...spotFor('noa-atalia'),
    tags: projectTags['noa-atalia'],
    mark: { x: 634, y: 393, w: 201, h: 82 },
    bg: backdropFor('noa-atalia'),
    /* From "HOVER 1 fixed", with the top clip pushed further right. */
    cards: [
      { video: `${base}/media/noa-atalia-clip`, x: 1430, y: 122, w: 237, h: 322 },
      { video: `${base}/media/car-fight`, x: 62, y: 582, w: 466, h: 262 },
      { video: `${base}/media/noa-atalia-insta`, x: 869, y: 643, w: 478, h: 269 },
    ],
  },
  {
    slug: 'prime-minister-next-door',
    number: '02',
    title: 'The Prime Minister Next Door',
    href: `${base}/projects/prime-minister-next-door`,
    ...spotFor('prime-minister-next-door'),
    tags: projectTags['prime-minister-next-door'],
    mark: { x: 867, y: 393, w: 201, h: 82 },
    bg: backdropFor('prime-minister-next-door'),
    cards: [
      { video: `${base}/media/prime-minister-card`, x: 20, y: 335, w: 498, h: 280 },
      /* A cut-out with no backing box, so it has to keep its alpha — video has
         none, which is why this one stays a GIF. */
      { gif: `${base}/media/prime-minister-bibi.gif`, x: 1380, y: 440, w: 320, h: 455 },
    ],
  },
  {
    slug: 'motion-design',
    number: '03',
    title: 'Motion Design',
    href: `${base}/projects/motion-design`,
    ...spotFor('motion-design'),
    tags: projectTags['motion-design'],
    mark: { x: 1113, y: 392, w: 201, h: 82 },
    bg: backdropFor('motion-design'),
    cards: [],
  },
  {
    slug: 'more-than-i-love-my-life',
    number: '04',
    title: 'More Than I Love My Life',
    href: `${base}/projects/more-than-i-love-my-life`,
    ...spotFor('more-than-i-love-my-life'),
    tags: projectTags['more-than-i-love-my-life'],
    mark: { x: 1344, y: 392, w: 177, h: 82 },
    bg: backdropFor('more-than-i-love-my-life'),
    cards: [
      { src: moreLayer14, x: 816, y: 82, w: 190, h: 227 },
      { video: `${base}/media/more-main1`, x: 1231, y: 100, w: 415, h: 233 },
      { src: moreLayer7, x: 992, y: 196, w: 130, h: 173 },
      /* Drawn exactly as the project page's opening row draws them (Figma
         frame 142:401, the row set with Layer 16's box at 80.3), so they do
         not move or turn on the way in. */
      { src: moreLayer16, x: 99.0, y: 333.0, w: 211, h: 296, rotate: -7.63 },
      { src: moreLayer8, x: 285.02, y: 503, w: 257, h: 352 },
      { video: `${base}/media/more-main2`, x: 949, y: 679, w: 414, h: 233 },
    ],
  },
  {
    slug: 'secrets',
    number: '05',
    title: 'Secrets',
    href: `${base}/projects/secrets`,
    ...spotFor('secrets'),
    tags: projectTags['secrets'],
    mark: { x: 631, y: 546, w: 201, h: 82 },
    bg: backdropFor('secrets'),
    cards: [],
  },
  {
    slug: '3-generations',
    number: '06',
    title: '3 Generations',
    href: `${base}/projects/3-generations`,
    ...spotFor('3-generations'),
    tags: projectTags['3-generations'],
    mark: { x: 867, y: 546, w: 201, h: 82 },
    bg: backdropFor('3-generations'),
    cards: [
      { src: building3, blend: 'screen', x: 344, y: -68, w: 382, h: 382 },
      { src: building1, blend: 'screen', x: 838, y: 46, w: 382, h: 381 },
      { src: building4, blend: 'screen', x: 1321, y: 134, w: 381, h: 382 },
      { src: building2, blend: 'screen', x: 54, y: 249, w: 381, h: 382 },
      { src: building5, blend: 'screen', x: 367, y: 582, w: 382, h: 382 },
      { src: building6, blend: 'screen', x: 968, y: 440, w: 382, h: 382 },
      { src: building7, blend: 'screen', x: 1305, y: 592, w: 382, h: 381 },
    ],
  },
  {
    slug: 'west-bank-barrier',
    number: '07',
    title: 'The West Bank Barrier',
    href: `${base}/projects/west-bank-barrier`,
    ...spotFor('west-bank-barrier'),
    tags: projectTags['west-bank-barrier'],
    mark: { x: 1115, y: 546, w: 201, h: 82 },
    bg: backdropFor('west-bank-barrier'),
    /* Figma floats two tall slices of the booklet over this — not exported yet. */
    cards: [],
  },
];
---

<BaseLayout title={siteConfig.title} description={siteConfig.description} image={noaAtaliaCover.src} bodyClass="home-fixed">
  <div class="canvas-wrap">
    <!-- ===== FULL-BLEED HOVER BACKDROP =====
         Outside the scaled canvas on purpose: it covers the entire browser
         window, so a hover fills the screen edge to edge whatever the viewport
         shape is. -->
    <div class="hover-bg-stack" aria-hidden="true">
      {projects.map((project) =>
        project.bg ? (
          <div
            class="hover-bg"
            data-for={project.slug}
            data-blend={project.cards.some((card) => card.blend) ? '' : undefined}
            style={project.bg.opacity ? `--bg-opacity:${project.bg.opacity};` : ''}>
            {'video' in project.bg ? (
              <video autoplay muted loop playsinline preload="metadata">
                <source src={`${project.bg.video}.webm`} type="video/webm" />
                <source src={`${project.bg.video}.mp4`} type="video/mp4" />
              </video>
            ) : (
              <Image src={(project.bg as { src: ImageMetadata }).src} alt="" widths={[1512, 2268]} sizes="100vw" quality={82} loading="eager" />
            )}
          </div>
        ) : null
      )}

      <!-- The floating images stay pinned to the canvas — their Figma
           coordinates only mean anything inside the 1728×982 frame. -->
      <div class="hover-card-stack" aria-hidden="true">
        {projects.map((project) => (
          <div
            class="hover-cards"
            data-for={project.slug}
            data-blend={project.cards.some((card) => card.blend) ? '' : undefined}
          >
            {project.cards.map((card, i) => (
              <div
                class="hover-card"
                data-blend={card.blend}
                data-turned={card.rotate ? '' : undefined}
                style={`--x:${card.x}; --y:${card.y}; --w:${card.w}; --h:${card.h}; --i:${i};${card.rotate ? ` --turn:${card.rotate}deg;` : ''}`}
              >
                {card.gif ? (
                  <img src={card.gif} alt="" loading="lazy" />
                ) : card.video ? (
                  <video autoplay muted loop playsinline preload="metadata">
                    <source src={`${card.video}.webm`} type="video/webm" />
                    <source src={`${card.video}.mp4`} type="video/mp4" />
                  </video>
                ) : (
                  <Image src={card.src} alt="" widths={[600, 960]} loading="eager" />
                )}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- Per-project tag row. It hangs off the wrapper, not the canvas, so it
         measures 20 from the right edge of the PAGE — the canvas is pinned left
         and its right edge stops short of the glass on a wide screen. -->
    {projects.map((project) => (
      <div class="hover-tags" data-for={project.slug}>
        <ProjectTags tags={project.tags} name={`tags-${project.slug}`} />
      </div>
    ))}

    <div class="canvas" data-hover="">
      <!-- The red groups slide in on the first visit only. Coming back to the
           home page from a project, the page is simply there as it was left:
           this runs while the page is still being read, before anything is
           drawn, so the groups never start their slide. -->
      <script is:inline>
        try {
          if (sessionStorage.getItem('home-entered')) document.currentScript.parentElement.classList.add('entered');
        } catch (e) {}
      </script>
      <Nav canvas />

      <!-- Figma: the name is its own canvas element at 263,198 — it sits over the
           red group rather than inside it, so it does not animate with it. -->
      <h1 class="name" style="view-transition-name: site-name"><a href={`mailto:${siteConfig.email}`}>Noa Kopelo</a></h1>

      <!-- Figma "Group 8", 618,245 · 198x35: the red pennant that opens out of
           the end of the name when the name is hovered. Its left edge carries
           the notch the file draws — (0,35) in to (4.5,18) and back out to
           (0,0) — so it reads as a tag pinned to the last letter. -->
      <div class="collab-banner" aria-hidden="true">
        <p class="collab-label">Open for collab :)</p>
      </div>

      <!-- Figma: red box "Group 1" 140,173 · 237×408 -->
      <div class="box intro-box">
        <p class="kicker-wide intro-kicker">Hi! I'm</p>
        <!-- Figma's phone frame breaks the copy after its first sentence. -->
        <p class="intro-copy">
          {siteConfig.description.split('. ')[0]}.<br class="phone-break" />
          {siteConfig.description.split('. ').slice(1).join('. ')}
        </p>
      </div>

      <!-- Figma: red box "Group 3" 1008,132 · 237×201 -->
      <div class="box note-box">
        <p class="note-copy">
          I love working with rhythm, archives, and typography across video editing, motion design, and editorial
          layouts
        </p>
      </div>

      <!-- Figma: red box "Group 2" 644,648 · 404×216 -->
      <div class="box skills-box">
        <p class="kicker-wide skills-kicker">Skills &amp; Software</p>
        <p class="skills-copy">
          Motion Design, Video Editing, Editorial Layout, Visual Storytelling, Typography Systems, Adobe Creative
          Suite, Figma, Procreate, Framer, Archival Research
        </p>
      </div>

      <!-- Figma: red box "Group 9" 1359,535 · 317×182 -->
      <div class="box ai-box">
        <p class="ai-copy">
          And yes, of course I work with AI. Whether it’s generating visuals and video, experimenting with code, or
          building interactive web experiences.
        </p>
      </div>

      <ul class="project-list" role="list">
        {projects.map((project) => (
          <li class="project-item" style={`--x:${project.x}; --y:${project.y}; --w:${project.w};`}>
            <a
              class="project-link"
              href={project.href}
              data-slug={project.slug}
            >
              <!-- Figma's Rectangle 11 in "HOVER 1": a 17.26 square drawn as
                   two sides and its diagonal, turned so the corner points down
                   and left at the number. In the frame it lands at 645,382.89
                   against a title box at 644,400 — one right, 17.38 up. -->
              <svg class="mark" viewBox="0 0 17.26 17.26" aria-hidden="true">
                <path d="M0.5 0.5V16.76H16.76M0.5 16.76L16.76 0.5" />
              </svg>
              <span class="num" style={`view-transition-name: num-${project.slug}`}>{project.number}</span>
              <span class="title" style={`view-transition-name: title-${project.slug}`}>{project.title}</span>
            </a>
          </li>
        ))}
      </ul>

      <!-- Figma: logo 47,915 · 30×28, with the face she drew inside the arch —
           eyes at (12,17) and (18,17) with radius 1, and an 8-wide smile
           starting at (11,21). The face only shows while the pennant is open. -->
      <span class="collab-mark" style="view-transition-name: site-mark">
        <img src={logoMark.src} alt="" />
        <svg class="mark-face" viewBox="0 0 30 28" aria-hidden="true">
          <circle cx="12" cy="17" r="1" />
          <circle cx="18" cy="17" r="1" />
          <path d="M 11 21 C 12.185 22.509 15.444 24.622 19 21" />
        </svg>
      </span>
    </div>
  </div>
</BaseLayout>

<style>
  /* ===== SCALED FIGMA CANVAS =====
     The homepage is one locked screen: the 1728x982 frame scaled to fit the
     window, never scrolling, never cropped. Every coordinate below is the
     literal Figma x/y/size. */
  .canvas-wrap {
    /* --u is one Figma pixel. It lives here, not on .canvas, because the hover
       layers sit outside the canvas and need the same scale.

       The scale fits BOTH axes, so the whole frame is always visible and nothing
       is ever cropped. On a window wider than 1728/982 that leaves empty space
       down the right-hand side — the design keeps its proportions rather than
       stretching to the glass.
       --ux is the same Figma pixel measured across the page's own width
       (100cqw of this wrap, so a Windows scrollbar is left out). Only the
       horizontal place of a piece uses it; sizes, type and heights stay on
       --u. On a Mac, whose window has the frame's own 1.76 shape, the two are
       one and the same. On a wider window (Windows, 16:9 less the taskbar,
       about 2.1) --u is set by the height and left 12-16% of the width empty
       on the right; --ux spreads the pieces across it instead. Pieces that
       are drawn against one another move as one, from a shared anchor. */
    --u: min(calc(100vw / 1728), calc(100vh / 982));
    --ux: calc(100cqw / 1728);
    container-type: inline-size;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* The canvas is exactly one screen: the 1728x982 frame scaled to fit the
     window on both axes, never scrolling. */
  .canvas {
    position: relative;
    flex: none;
    width: 100%;
    height: calc(982 * var(--u));
    /* Transparent and above the hover layers, so the backdrop shows through. */
    z-index: 1;
  }

  /* ===== HOVER TAKEOVER =====
     One layer per project, stacked behind the canvas text. Hovering a project
     title fades its layer up to fill the whole frame, exactly as in the
     HOVER 1–7 frames in Figma. */
  /* Full-bleed: pinned to the window, not to the scaled canvas. */
  .hover-bg-stack {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Confines mix-blend-mode to this group: a blended card sees the backdrop
       image below it and nothing further up the page. */
    isolation: isolate;
  }

  .hover-bg {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 420ms ease,
      visibility 0s linear 420ms;
  }

  .hover-bg.is-active {
    opacity: var(--bg-opacity, 1);
    visibility: visible;
    transition:
      opacity 420ms ease,
      visibility 0s;
  }

  /* A screen blend draws a card against whatever is under it. While the map
     was still fading up there was nothing under the buildings, so they came
     in in full colour and only turned to the pale Figma look 420ms later. The
     map behind them therefore arrives at once rather than fading. */
  .hover-bg[data-blend].is-active {
    transition: none;
  }

  .hover-bg :global(img),
  .hover-bg video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Two scales at once. --ux spreads the cards across the full width of the
     window, so they never look bunched into a narrow strip. Height, size and
     vertical position stay on the canvas's --u, which keeps them level with the
     type and stops them growing taller than the screen — scaling both axes off
     the width is what pushed a top card into the tag row and cut the feet off a
     bottom one. */
  .hover-card-stack {
    position: absolute;
    left: 0;
    top: calc(50% - 491 * var(--u));
    width: 100%;
    height: calc(982 * var(--u));
    overflow: hidden;
  }

  /* The group only shows and hides. It must not carry its own opacity: a value
     between 0 and 1 opens a stacking context, which cuts a blended card off from
     the backdrop for the whole fade and then snaps it back at the end. */
  .hover-cards {
    position: absolute;
    inset: 0;
    visibility: hidden;
    transition: visibility 0s linear 420ms;
  }

  .hover-cards.is-active {
    visibility: visible;
    transition: visibility 0s;
  }

  /* And on the way out they go with the hover, not after the map has faded
     from under them, which would flash them in colour again. */
  .hover-cards[data-blend]:not(.is-active) {
    transition: none;
  }

  /* They come up a beat after the backdrop, one after another. */
  .hover-card {
    position: absolute;
    left: calc(var(--x) * var(--ux));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    overflow: hidden;
    opacity: 0;
    transform: translateY(calc(12 * var(--u)));
    transition:
      opacity 420ms ease,
      transform 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .hover-cards.is-active .hover-card {
    opacity: 1;
    transform: none;
    transition-delay: calc(120ms + var(--i) * 70ms);
  }

  /* Figma blends the 3 Generations buildings onto the map rather than stacking
     them opaquely — without this they read as flat pasted squares. */
  .hover-card[data-blend='screen'] {
    mix-blend-mode: screen;
    /* For the same reason, a blended card never fades — it slides in already
       blended rather than arriving opaque and popping. */
    opacity: 1;
    transition: transform 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* A card Figma turns. The turn goes on the picture, since the card's own
     transform is its slide in, and the card lets the turned corners out. */
  .hover-card[data-turned] {
    overflow: visible;
  }

  .hover-card[data-turned] :global(img) {
    transform: rotate(var(--turn));
  }

  /* contain, not cover: a card must never crop its picture. The backdrop still
     covers, because that one is meant to bleed. */
  .hover-card :global(img),
  .hover-card img,
  .hover-card video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hover-tags {
    position: absolute;
    inset: 0;
    z-index: 3;
    /* It spans the whole page, so it must not intercept the hover it reacts to. */
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 420ms ease,
      visibility 0s linear 420ms;
  }

  .hover-tags.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 420ms ease,
      visibility 0s;
  }

  /* ===== RED GROUPS =====
     They slide into the frame from outside it, fast, one after another, in
     Figma's own order: Group 1 from the left, Group 2 from below, Group 3 from
     above, Group 9 from the right. No fade — each is simply off the glass until it arrives. Each box
     sets its own start in --from-x / --from-y, as a length. They step aside the
     moment a hover takes over the screen. */
  @keyframes rise-in {
    from {
      transform: translate(var(--from-x, 0px), var(--from-y, 0px));
    }
    to {
      transform: none;
    }
  }

  .box {
    position: absolute;
    /* Below the name: Group 1 overlaps it, and the type reads on top. */
    z-index: 1;
    box-shadow: inset 0 0 0 1px var(--color-accent);
    animation: rise-in 850ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--delay) * 1ms);
  }

  /* Once the entrance has played, the boxes drop the animation for good and are
     driven by a plain transition — otherwise clearing the hover class restarts
     the whole staggered entrance, delays and all. */
  .canvas.entered .box {
    opacity: 1;
    animation: none;
    transition: opacity 320ms ease;
  }

  .canvas.entered.is-hovering .box {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .box {
      opacity: 1;
      animation: none;
    }

    /* The pennant still arrives on hover, it just does not unroll, and the
       mark holds still. */
    .collab-banner {
      transition: none;
    }

    .canvas:has(.name:hover) .collab-mark,
    .canvas:has(.name:focus-visible) .collab-mark,
    .collab-mark:hover {
      animation: none;
    }
  }

  .intro-box {
    /* Group 1. Its right edge lands just past where the "a" of "Noa" begins
       (the a starts at 358.4 in frame units, the box ends at 365). */
    --delay: 200;
    /* The canvas is pinned to the window's left edge, so x + w clears it. */
    /* Drawn against the name (its edge meets the "a"), so it hangs off the
       name's centre, 445.5, rather than spreading on its own. The slide starts
       with its right edge on the window's left. */
    --from-x: calc(-445.5 * var(--ux) + (445.5 - 127 - 237) * var(--u));
    left: calc(445.5 * var(--ux) + (127 - 445.5) * var(--u));
    top: calc(173 * var(--u));
    width: calc(237 * var(--u));
    height: calc(408 * var(--u));
  }

  .note-box {
    --delay: 1300; /* Group 3 */
    /* From above: the window's top edge is 50vh - 491u above the canvas's
       middle, and the box's bottom, at 132 + 201, has to clear it. */
    --from-y: calc((491 - 132 - 201) * var(--u) - 50vh);
    left: calc(1008 * var(--ux));
    top: calc(132 * var(--u));
    width: calc(237 * var(--u));
    height: calc(201 * var(--u));
  }

  .skills-box {
    --delay: 750; /* Group 2 */
    /* The canvas sits centred in the window, so the window's bottom edge is
       50vh + 491u below the canvas's middle; the box's top, at 648, has to
       travel to there. */
    --from-y: calc(50vh + (491 - 648) * var(--u));
    left: calc(644 * var(--ux));
    top: calc(648 * var(--u));
    width: calc(404 * var(--u));
    height: calc(216 * var(--u));
  }

  .ai-box {
    --delay: 1850; /* Group 9, on the same 550 beat */
    /* From the right: it stands against the right of the frame, so it comes
       in past the window's right edge, 1728 - 1359 away. */
    --from-x: calc((1728 - 1359) * var(--ux));
    left: calc(1359 * var(--ux));
    top: calc(535 * var(--u));
    width: calc(317 * var(--u));
    height: calc(182 * var(--u));
  }

  /* Text inside the boxes — positioned against each box's own origin. */
  .intro-kicker {
    position: absolute;
    left: calc(138 * var(--u));
    top: calc(12 * var(--u));
    white-space: nowrap;
  }

  /* The name is the invitation the pennant spells out, so it opens a mail to
     her — it carries none of a link's own colour or underline. */
  .name a {
    color: inherit;
    text-decoration: none;
  }

  .name {
    /* Figma: 260,198, 371 wide — centred on 445.5, never wrapping. */
    position: absolute;
    left: calc(445.5 * var(--ux));
    top: calc(198 * var(--u));
    transform: translateX(-50%);
    white-space: nowrap;
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: calc(80 * var(--u));
    line-height: 1.35;
    letter-spacing: -0.07em;
    text-align: center;
    color: var(--color-text);
  }

  .intro-copy {
    position: absolute;
    left: calc(21 * var(--u));
    top: calc(132 * var(--u));
    --w: 185;
  }

  .note-copy {
    position: absolute;
    left: calc(21 * var(--u));
    top: calc(12 * var(--u));
    --w: 201;
  }

  .skills-kicker {
    position: absolute;
    left: calc(136 * var(--u));
    top: calc(13 * var(--u));
    width: calc(258 * var(--u));
  }

  .skills-copy {
    position: absolute;
    left: calc(22 * var(--u));
    top: calc(69 * var(--u));
    --w: 356;
  }

  .ai-copy {
    position: absolute;
    left: calc(18 * var(--u));
    top: calc(14 * var(--u));
    --w: 290;
  }

  /* Figma: 16px General Sans Light, 3.2px tracking, uppercase, red.
     The +3.2 on the width compensates for CSS adding letter-spacing after the
     last character of a line, which Figma does not — without it these blocks
     wrap one line early. */
  .intro-copy,
  .note-copy,
  .skills-copy,
  .ai-copy {
    width: calc((var(--w) + 3.2) * var(--u));
    margin: 0;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: calc(16 * var(--u));
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.375;
    color: var(--color-accent);
  }

  /* Figma: 16px, 6.4px tracking, red */
  .kicker-wide {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: calc(16 * var(--u));
    letter-spacing: 0.4em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--color-accent);
  }

  .project-list {
    position: relative;
    z-index: 3;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-item {
    position: absolute;
    left: calc(var(--x) * var(--ux));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
  }

  .project-link {
    position: relative;
    display: block;
    color: var(--color-text);
  }

  /* Figma's Rectangle 11 — the arrow that marks the hovered project, in place
     of the old Rectangle 13 frame, which the file now hides. It sits over the
     number: one unit right of the title box and 17.38 above it. */
  .mark {
    position: absolute;
    left: calc(1 * var(--u));
    top: calc(-17.38 * var(--u));
    width: calc(17.38 * var(--u));
    height: calc(17.38 * var(--u));
    overflow: visible;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0;
    transition: opacity 240ms ease;
    pointer-events: none;
  }

  .project-link:hover .mark,
  .project-link:focus-visible .mark {
    opacity: 1;
  }

  /* Figma: 18px, -1.26px tracking — set to -0.72px (-0.04em) at her ask. */
  .num {
    display: block;
    font-family: var(--font-display);
    font-weight: 200;
    font-size: calc(18 * var(--u));
    letter-spacing: -0.04em;
    color: var(--color-accent);
  }

  .title {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: calc(18 * var(--u));
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  /* One line each, as the file sets them — their Figma boxes are a shade
     narrower than the type needs once it is rendered here, which broke them
     over two. There is a clear column to the right of both. */
  .project-link[data-slug='noa-atalia'] .title,
  .project-link[data-slug='3-generations'] .title {
    white-space: nowrap;
  }

  .collab-mark {
    position: absolute;
    left: calc(47 * var(--ux));
    top: calc(915 * var(--u));
    width: calc(30 * var(--u));
    height: calc(28 * var(--u));
    z-index: 3;
    display: block;
    transform-origin: 50% 100%;
  }

  .collab-mark img,
  .mark-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The face sits in the gap between the arch's legs, where the page's own
     background shows through, so it is drawn in the same red as the mark. */
  .mark-face {
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .mark-face circle {
    fill: var(--color-accent);
  }

  .mark-face path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    stroke-linecap: round;
  }

  /* Figma "Group 8": the pennant beside the name, 35 tall, unrolling left to
     right out of the end of "Kopelo" while the name is hovered.

     The file notches its left edge 4.5 deep at mid-height, which is the right
     idea — the shape has to be cut in where the round "o" bulges out — but
     that "o" bulges 9, not 4.5, so a crescent of red showed around it. The
     edge here follows the letter instead: the final o's ink is measured at
     589.18..630.78 across and 239.66..283.66 down, an ellipse centred on
     (609.98, 261.66) with radii 20.8 and 22, and these five depths are that
     ellipse sampled at the pennant's top, quarters, middle and bottom. The
     red therefore never leaves the letter, and still starts behind it. */
  .collab-banner {
    position: absolute;
    /* Cut to the name's last "o", so it hangs off the name's centre. */
    left: calc(445.5 * var(--ux) + (621 - 445.5) * var(--u));
    top: calc(245 * var(--u));
    /* Her length, kept: the pennant still ends at 836. */
    --bw: 215;
    width: calc(var(--bw) * var(--u));
    height: calc(35 * var(--u));
    /* Under the name, as the file stacks it: the pennant slides out from
       behind the last letter rather than over it. */
    z-index: 1;
    display: flex;
    align-items: center;
    padding-left: calc(19 * var(--u));
    background: var(--color-accent);
    pointer-events: none;
    /* Clipped rather than scaled, so the red unrolls to the right while the
       letters behind it keep their own shape instead of stretching out of it.

       Closed, the two right-hand corners come back to the letter's own curve
       rather than to the element's left edge — collapsing them to 0 walked
       them past the o, and a sliver of red showed on the way in and out. The
       five edge points never move at all. */
    clip-path: polygon(
      calc(2.56 / var(--bw) * 100%) 0,
      calc(2.56 / var(--bw) * 100%) 0,
      calc(0.47 / var(--bw) * 100%) 100%,
      calc(0.47 / var(--bw) * 100%) 100%,
      calc(7.7 / var(--bw) * 100%) 75%,
      calc(9.77 / var(--bw) * 100%) 50%,
      calc(8.39 / var(--bw) * 100%) 25%
    );
    /* What is left of the shape when it is closed is the hair between that
       chord and the curve, which the letter covers — but it is switched off
       at the end of the roll anyway, and back on at the very start of it. */
    opacity: 0;
    transition:
      clip-path 460ms cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0s linear 460ms;
  }

  /* The name and the mark do the same thing, and the mark comes first in the
     DOM, so the state is read off the canvas with :has rather than with a
     sibling combinator. */
  .canvas:has(.name:hover) .collab-banner,
  .canvas:has(.name:focus-visible) .collab-banner,
  .canvas:has(.collab-mark:hover) .collab-banner,
  .collab-banner.open {
    opacity: 1;
    transition:
      clip-path 460ms cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0s linear;
    clip-path: polygon(
      calc(2.56 / var(--bw) * 100%) 0,
      100% 0,
      100% 100%,
      calc(0.47 / var(--bw) * 100%) 100%,
      calc(7.7 / var(--bw) * 100%) 75%,
      calc(9.77 / var(--bw) * 100%) 50%,
      calc(8.39 / var(--bw) * 100%) 25%
    );
  }

  /* Vector 6 rocks gently from side to side on its own base, a few degrees
     either way, and its face appears for as long as the hover lasts. */
  .canvas:has(.name:hover) .collab-mark,
  .canvas:has(.name:focus-visible) .collab-mark,
  .collab-mark:hover {
    animation: mark-sway 2.4s ease-in-out infinite;
  }

  .canvas:has(.name:hover) .mark-face,
  .canvas:has(.name:focus-visible) .mark-face,
  .collab-mark:hover .mark-face {
    opacity: 1;
  }

  @keyframes mark-sway {
    0%,
    100% {
      transform: rotate(-5deg);
    }
    50% {
      transform: rotate(5deg);
    }
  }

  /* Figma: 20px General Sans Extralight, -1.4px tracking — set to -0.8px
     (-0.04em) at her ask — in the background colour, 19 in from the left. */
  .collab-label {
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 200;
    font-size: calc(20 * var(--u));
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--color-bg);
  }

  /* A line break only the phone frame draws. */
  .phone-break {
    display: none;
  }

  /* ===== PHONE =====
     Drawn on Figma's 402-wide "iPhone 17" frame (node 256:98; --u becomes
     --m, one of its pixels, so the file's numbers read as they are). The top
     is the frame's own: CONTACT left, the mark in the middle, CV right; Group
     1 at 20,83, 200 x 336, with the name at 69 across it. Then, on the 20
     margins, Group 3 right, the list, Group 2 left, Group 9 right, and the
     OPEN FOR COLLAB pennant as a red band across the foot of the page. There is no hover on a phone, so the project that crosses the
     middle of the screen as the list is scrolled takes the hover instead:
     its backdrop fills the glass behind the list, the groups step aside, and
     its mark comes up over its number. */
  @media (max-width: 640px) {
    .canvas-wrap {
      --u: var(--m);
      --ux: var(--m);
      display: block;
      width: auto;
      height: auto;
      overflow: visible;
    }

    .canvas {
      width: auto;
      height: auto;
      display: flex;
      flex-direction: column;
      /* Group 1 runs to 419; the rest follows 44 under it. */
      padding: calc(463 * var(--m)) calc(20 * var(--m)) 0;
    }

    .phone-break {
      display: inline;
    }

    /* The backdrop is pinned to the glass, behind everything; the cards and
       the tag row belong to the desktop frame and stay off. */
    .hover-bg-stack {
      position: fixed;
      z-index: 0;
    }

    .hover-card-stack,
    .hover-tags {
      display: none;
    }

    /* Figma: 69 Medium, -4.83 tracking, centred on 211 at 121 — over Group
       1, which it crosses. */
    .name {
      left: calc(211 * var(--m));
      top: calc(121 * var(--m));
      font-size: calc(69 * var(--m));
    }

    /* A red band across the foot of the page, edge to edge, always there. */
    .collab-banner {
      order: 99;
      position: relative;
      left: auto;
      top: auto;
      align-self: stretch;
      width: auto;
      height: calc(48 * var(--m));
      margin: calc(72 * var(--m)) calc(-20 * var(--m)) 0;
      padding-left: calc(20 * var(--m));
      opacity: 1;
      transition: none;
      clip-path: none;
    }

    .collab-label {
      font-size: calc(18 * var(--m));
    }

    /* The red groups, each sized to its words, on alternate margins. */
    .box {
      position: relative;
      left: auto;
      top: auto;
      height: auto;
      padding: calc(16 * var(--m)) calc(16 * var(--m)) calc(18 * var(--m));
      --from-x: 0px;
      --from-y: calc(24 * var(--m));
    }

    /* Figma's Group 1, where the frame draws it. */
    .intro-box {
      position: absolute;
      left: calc(20 * var(--m));
      top: calc(83 * var(--m));
      width: calc(200 * var(--m));
      height: calc(336 * var(--m));
      padding: 0;
    }

    .note-box {
      order: 4;
      width: calc(250 * var(--m));
      align-self: flex-end;
    }

    .project-list {
      order: 5;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: calc(20 * var(--m));
      row-gap: calc(34 * var(--m));
      margin: calc(64 * var(--m)) 0 calc(64 * var(--m));
      padding: 0;
    }

    .skills-box {
      order: 6;
      width: calc(300 * var(--m));
    }

    .ai-box {
      order: 7;
      width: calc(262 * var(--m));
      margin-top: calc(24 * var(--m));
      align-self: flex-end;
    }

    .note-copy,
    .skills-kicker,
    .skills-copy,
    .ai-copy {
      position: static;
      width: auto;
    }

    .skills-kicker {
      text-align: right;
      margin-bottom: calc(12 * var(--m));
    }

    /* Group 1's words where the frame sets them: HI! I'M at 136.35,93.12
       and the copy at 39,214, 156 wide (+ the 2.4 tracking CSS adds at the
       end of a line) — both against the box's own corner at 20,83. */
    .intro-kicker {
      left: calc(116.35 * var(--m));
      top: calc(10.12 * var(--m));
      width: calc(70 * var(--m));
    }

    .intro-copy {
      left: calc(19 * var(--m));
      top: calc(131 * var(--m));
      width: calc(158.4 * var(--m));
      line-height: 1.35;
    }

    .note-copy,
    .skills-copy,
    .ai-copy {
      line-height: 1.45;
    }

    /* Figma: 12 Light, 2.4 tracking; the kickers at 4.8. */
    .intro-copy,
    .note-copy,
    .skills-copy,
    .ai-copy {
      font-size: calc(12 * var(--m));
      letter-spacing: 0.2em;
    }

    .kicker-wide {
      font-size: calc(12 * var(--m));
      letter-spacing: 0.4em;
    }

    .project-item {
      position: relative;
      left: auto;
      top: auto;
      width: auto;
    }

    /* The item crossing the middle of the screen wears the hover's mark. */
    .project-item.is-active .mark {
      opacity: 1;
    }

    .num,
    .title {
      font-size: calc(15 * var(--m));
    }

    .project-link[data-slug='noa-atalia'] .title,
    .project-link[data-slug='3-generations'] .title {
      white-space: normal;
    }

    /* Vector 6 in the middle of the bar — smaller than the frame's 30 x 28
       at her ask, 22 x 20.5, and centred on the bar's line. */
    .collab-mark {
      position: absolute;
      left: calc(50% - 11 * var(--m));
      top: calc(35.5 * var(--m));
      width: calc(22 * var(--m));
      height: calc(20.5 * var(--m));
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLElement>('.canvas');
  const links = document.querySelectorAll<HTMLAnchorElement>('.project-link');
  const layers = document.querySelectorAll<HTMLElement>('.hover-bg, .hover-cards, .hover-tags');

  /* One shared switch: the backdrop, the floating cards and the tag row for a
     project all carry the same data-for, so a single slug lights up all three.
     Each video offers WebM first and falls back to mp4, and only loads its
     metadata up front — the frames arrive when a hover actually asks. */
  const show = (slug: string | null) => {
    if (!canvas) return;
    canvas.classList.toggle('is-hovering', Boolean(slug));
    canvas.dataset.hover = slug ?? '';

    layers.forEach((layer) => {
      const active = layer.dataset.for === slug;
      layer.classList.toggle('is-active', active);

      layer.querySelectorAll<HTMLVideoElement>('video').forEach((video) => {
        if (active) {
          /* Autoplay is only permitted for a muted video, and a hover is not a
             user gesture — so muting is re-asserted here before every play. */
          video.muted = true;
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    });
  };

  /* The red groups slide in once per visit — see the inline script at the
     top of the canvas, which skips it on the way back. */
  const boxes = document.querySelectorAll<HTMLElement>('.box');
  const markEntered = () => {
    canvas?.classList.add('entered');
    try {
      sessionStorage.setItem('home-entered', '1');
    } catch {}
  };
  let settled = 0;
  boxes.forEach((box) =>
    box.addEventListener('animationend', () => {
      if (++settled >= boxes.length) markEntered();
    }, { once: true })
  );
  /* No animation fires under reduced motion, so nothing would ever settle. */
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) markEntered();

  const phone = window.matchMedia('(max-width: 640px)');

  links.forEach((link) => {
    const slug = link.dataset.slug ?? null;
    link.addEventListener('mouseenter', () => !phone.matches && show(slug));
    link.addEventListener('focus', () => !phone.matches && show(slug));
    link.addEventListener('mouseleave', () => !phone.matches && show(null));
    link.addEventListener('blur', () => !phone.matches && show(null));
  });

  /* On a phone the scroll does the hovering. The stretch of scroll from a
     tenth of a window before the list reaches the middle of the screen to a
     quarter after it has passed is cut into seven equal turns — a tenth, not
     more, before it, so the first screen opens clear and 01 does not light up
     before anything has been scrolled — one per
     project in the list's own order — both columns, so the right-hand one
     gets its turn too, which "nearest the middle" would never give it. The
     project whose turn it is lights up exactly as a hover does. */
  const list = document.querySelector<HTMLElement>('.project-list');
  const items = [...document.querySelectorAll<HTMLElement>('.project-item')];
  let turn: string | null = null;
  let pending = false;

  const pick = () => {
    pending = false;
    if (!phone.matches || !list) return;
    const middle = window.innerHeight / 2;
    const box = list.getBoundingClientRect();
    const from = box.top - window.innerHeight * 0.1;
    /* It ends a quarter of a window past the list — or where the middle of
       the screen can reach at all, if the page runs out first, so that the
       last project still gets its turn. */
    const bottomY = document.documentElement.scrollHeight - window.innerHeight;
    const furthest = bottomY - window.scrollY + middle - 1;
    const to = Math.min(box.bottom + window.innerHeight * 0.25, furthest);
    const span = to - from;
    const t = (middle - from) / span;
    const at = t >= 0 && t < 1 ? Math.floor(t * items.length) : -1;
    const slug = at >= 0 ? items[at].querySelector<HTMLElement>('.project-link')?.dataset.slug ?? null : null;
    if (slug === turn) return;
    turn = slug;
    items.forEach((item, i) => item.classList.toggle('is-active', i === at));
    show(slug);
  };

  const onScroll = () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(pick);
  };

  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  phone.addEventListener('change', () => {
    if (!phone.matches) {
      turn = null;
      items.forEach((item) => item.classList.remove('is-active'));
      show(null);
    } else onScroll();
  });
  pick();
</script>
