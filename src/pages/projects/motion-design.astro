---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectHeader from '@components/project/ProjectHeader.astro';
import PhoneCarousel from '@components/project/PhoneCarousel.astro';
import { siteConfig } from '@config/site';
import vinylDay from '@assets/projects/motion-graphic/vinyl-day.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Motion Design';
const description =
  'A collection of motion design projects, animated posters, and video experiments created for various events, cultural platforms, and personal explorations.';

/* The seven pieces, one at a time, in a phone you page through. */
const films = [
  { src: `${base}/media/motion-deadsea`, title: 'Dead Sea' },
  { src: `${base}/media/motion-rujum`, title: 'Rujum' },
  { src: `${base}/media/motion-passport`, title: 'Passport' },
  { src: `${base}/media/motion-vip-passengers`, title: "Nosi'im Nichbadim" },
  { src: `${base}/media/motion-vinyl-day`, title: 'Vinyl Day' },
  { src: `${base}/media/motion-flight`, title: 'Flight' },
  { src: `${base}/media/motion-rings`, title: 'Rings' },
];

/* It stands in the gap between the name, which ends at 631, and the title,
   which starts at 1126 — centred on 878. 914 frame units is 800px on a 900px
   screen, which runs past the 982 fold, so the frame is made tall enough to
   hold it and the page scrolls. 9:19.5, so the width follows the height. */
const PHONE_TOP = 380;
const PHONE_HEIGHT = 914;
const PHONE_WIDTH = Math.round((PHONE_HEIGHT * 9) / 19.5);
const PHONE_LEFT = Math.round(878 - PHONE_WIDTH / 2);
const FRAME_HEIGHT = PHONE_TOP + PHONE_HEIGHT + 120;
---

<BaseLayout title={`${title} — ${siteConfig.name}`} description={description} image={vinylDay.src}>
  <ProjectHeader
    slug="motion-design"
    number="03"
    title={title}
    description={description}
    frameHeight={FRAME_HEIGHT}
    stays={[
      { phone: true as const, x: PHONE_LEFT, y: PHONE_TOP, w: PHONE_WIDTH, h: PHONE_HEIGHT },
    ]}
  >
    <PhoneCarousel slot="phone" films={films} label="Motion pieces" />
  </ProjectHeader>
</BaseLayout>
