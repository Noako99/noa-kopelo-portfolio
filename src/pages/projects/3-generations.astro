---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectHeader from '@components/project/ProjectHeader.astro';
import ProjectCanvas from '@components/project/ProjectCanvas.astro';
import { siteConfig } from '@config/site';
import building1 from '@assets/projects/3-generations/building-1.png';
import building2 from '@assets/projects/3-generations/building-2.png';
import building3 from '@assets/projects/3-generations/building-3.png';
import building4 from '@assets/projects/3-generations/building-4.png';
import building5 from '@assets/projects/3-generations/building-5.png';
import mapBg from '@assets/projects/3-generations/map-bg.jpg';
import avatar1 from '@assets/projects/3-generations/avatar-1.png';
import avatar2 from '@assets/projects/3-generations/avatar-2.png';
import avatar3 from '@assets/projects/3-generations/avatar-3.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = '3 Generations';
const description =
  'An interactive web experience mapping Jerusalem through the personal memories and everyday spaces of three generations of women. Blending family archives, lived geography, and interactive storytelling, the project explores how a single city shifts across time and personal history.';

/* Straight off the Figma frame "3 Generations" (1512x3117). */
const pieces = [
  /* The palette, top to bottom, at 108 with its hex underneath. */
  { color: '#E2ECF4', label: 'E2ECF4', x: 108, y: 1040, w: 99, h: 95 },
  { color: '#CFD6BB', label: 'CFD6BB', x: 108, y: 1181, w: 99, h: 95 },
  { color: '#DCD7B9', label: 'DCD7B9', x: 108, y: 1318, w: 99, h: 95 },
  { color: '#ECE2CF', label: 'ECE2CF', x: 108, y: 1455, w: 99, h: 95 },
  { color: '#ED9A6E', label: 'ED9A6E', x: 108, y: 1593, w: 99, h: 95 },

  { video: `${base}/media/three-generations`, controls: true, formats: ['mp4'], x: 292, y: 1030, w: 1130, h: 701 },
  /* Figma lays them out "Untitled-1-03", "-01", "-02" from left to right. */
  { src: avatar3, alt: 'Jerusalem, 2022', x: 89, y: 1789, w: 421, h: 421 },
  { src: avatar1, alt: 'Jerusalem, 1989', x: 545, y: 1789, w: 421, h: 421 },
  { src: avatar2, alt: 'Jerusalem, 1956', x: 1001, y: 1789, w: 421, h: 421 },
];
---

<BaseLayout title={`${title} — ${siteConfig.name}`} description={description} image={mapBg.src}>
  <ProjectHeader
    slug="3-generations"
    number="06"
    title={title}
    description={description}
    stays={[
      /* The five buildings, exactly where Figma scatters them over the fold. */
      { src: building3, x: 301, y: -68, w: 382, h: 382 },
      { src: building1, x: 733, y: 46, w: 382, h: 381 },
      { src: building4, x: 1156, y: 134, w: 381, h: 382 },
      { src: building2, x: 47, y: 249, w: 381, h: 382 },
      { src: building5, x: 321, y: 582, w: 382, h: 382 },
    ]}
  />

  <ProjectCanvas width={1512} height={3117} offsetY={990} tail={200} items={pieces} />
</BaseLayout>
