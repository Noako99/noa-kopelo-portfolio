---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectHeader from '@components/project/ProjectHeader.astro';
import ProjectCanvas from '@components/project/ProjectCanvas.astro';
import { siteConfig } from '@config/site';
import bookLeft from '@assets/projects/secrets/book-left.png';
import bookRight from '@assets/projects/secrets/book-right.png';

const title = 'Secrets';
const description =
  'An intimate editorial publication examining the emotional weight of keeping secrets and the vulnerability of being hidden. Designed in a compact, tactile format across three distinct sections, the book functions as a personal artifact — meant to be kept close, held in private, and read quietly.';

/* Straight off the Figma frame "secrets" (1512x3117). */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pieces = [
  { video: `${base}/media/secrets-book`, controls: true, x: 73, y: 942, w: 1378, h: 775 },
];
---

<BaseLayout title={`${title} — ${siteConfig.name}`} description={description} image={bookLeft.src}>
  <ProjectHeader
    slug="secrets"
    number="05"
    title={title}
    description={description}
    stays={[
      /* "00 3" and "00 2" are the two books of the same photograph, cut out of
         it. Each box keeps the book's own 757x983, scaled to fit the bounding
         box Figma reports (183.6,336 313.7x427.8 and 385.9,530 277.6x401.5)
         at its turn, and centred on it.
         At her ask the pair stands to the right of the title and description,
         20% larger: the two as Figma arranges them (turned, together
         154-634 x 440-979 on the page), scaled 1.2 about their top left and
         moved so that corner lands at 1060,300 — 63 clear of the
         description's column, and ending at 1635 x 947, inside the fold. */
      { src: bookLeft, x: 1099.5, y: 328.6, w: 297.6, h: 385.2, rotate: -13 },
      { src: bookRight, x: 1316.7, y: 542.2, w: 303.6, h: 393.6, rotate: 4.5 },
    ]}
  />

  <ProjectCanvas width={1512} height={3117} offsetY={902} tail={160} items={pieces} />
</BaseLayout>
