---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectHeader from '@components/project/ProjectHeader.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '@config/site';
import bookDetail from '@assets/projects/secrets/book-detail.jpg';
import detail2 from '@assets/projects/secrets/detail-2.jpg';
import hero from '@assets/projects/secrets/hero.png';

const title = 'Secrets';
const description =
  'An intimate editorial publication examining the emotional weight of keeping secrets and the vulnerability of being hidden. Designed in a compact, tactile format across three distinct sections, the book functions as a personal artifact — meant to be kept close, held in private, and read quietly.';
---

<BaseLayout title={`${title} — ${siteConfig.name}`} description={description} image={bookDetail.src}>
  <ProjectHeader
    number="05"
    title={title}
    description={description}
    tags={['Typography', 'Book Design', 'Print Production', 'Storytelling']}
  />

  <section class="media">
    <div class="detail-row">
      <figure class="detail-cover"><Image src={bookDetail} alt="Secrets book cover detail" width={400} /></figure>
      <figure class="detail-spread"><Image src={detail2} alt="Secrets book spread detail" width={400} /></figure>
    </div>
    <figure class="hero">
      <Image src={hero} alt="Secrets book, full view" width={1100} />
    </figure>
  </section>
</BaseLayout>

<style>
  .media {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0 var(--space-lg) var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  figure {
    margin: 0;
  }

  figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .detail-row {
    display: flex;
    gap: var(--space-lg);
  }

  .detail-cover {
    max-width: 12rem;
  }

  .detail-spread {
    max-width: 12rem;
  }

  .hero {
    background: #000;
    padding: var(--space-2xl);
    display: flex;
    justify-content: center;
  }

  .hero :global(img) {
    max-width: 20rem;
    width: 100%;
  }

  @media (max-width: 640px) {
    .detail-row {
      flex-wrap: wrap;
    }

    .hero {
      padding: var(--space-lg);
    }
  }
</style>
