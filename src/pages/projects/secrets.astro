---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectHeader from '@components/project/ProjectHeader.astro';
import ProjectPager from '@components/project/ProjectPager.astro';
import ProjectCanvas from '@components/project/ProjectCanvas.astro';
import Lightbox from '@components/project/Lightbox.astro';
import { siteConfig } from '@config/site';
import type { ImageMetadata } from 'astro';
import bookLeft from '@assets/projects/secrets/book-left.png';
import bookRight from '@assets/projects/secrets/book-right.png';
import backdrop from '@assets/projects/secrets/hover-bg.jpg';
import detail1 from '@assets/projects/secrets/details/detail-1.jpg';
import detail2 from '@assets/projects/secrets/details/detail-2.jpg';
import detail3 from '@assets/projects/secrets/details/detail-3.jpg';
import detail4 from '@assets/projects/secrets/details/detail-4.jpg';
import detail6 from '@assets/projects/secrets/details/detail-6.jpg';
import detail6B from '@assets/projects/secrets/details/detail-6b.jpg';
import detail7 from '@assets/projects/secrets/details/detail-7.jpg';
import detail8 from '@assets/projects/secrets/details/detail-8.jpg';
import detail9 from '@assets/projects/secrets/details/detail-9.jpg';
import detail10 from '@assets/projects/secrets/details/detail-10.jpg';
import detail11 from '@assets/projects/secrets/details/detail-11.jpg';
import detail12 from '@assets/projects/secrets/details/detail-12.jpg';
import detail13 from '@assets/projects/secrets/details/detail-13.jpg';
import detail14 from '@assets/projects/secrets/details/detail-14.jpg';
import detail15 from '@assets/projects/secrets/details/detail-15.jpg';

const title = 'Secrets';
const description =
  'An intimate editorial publication examining the emotional weight of keeping secrets and the vulnerability of being hidden. Designed in a compact, tactile format across three distinct sections, the book functions as a personal artifact — meant to be kept close, held in private, and read quietly.';

/* Straight off the Figma frame "secrets" (1512x4809). */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* Details from inside the book, under the film: Figma's grid of 4 columns
   and 6 rows of 332 squares, 16 apart (a pitch of 348), from 73,1777 —
   with cells left empty, so no row or column is full. The file had a few
   squares a few units off the grid (430 for 421, 761 for 769, rows 2 low);
   they sit on it here. The film and the grid ride the scroll as one rigid
   block, at the speed the film had on its own (its band's -0.02, tripled as
   every unset piece is): moving apart, the grid closed the 60 under the
   film and ran into it. */
const DRIFT = -0.06;
/* On the site's content margins, 73 to 1439 — 05's own left edge on both
   sides — the film narrows from 1378 to 1366 and the four columns to
   329.5, still 16 apart; the grid keeps its 60 under the film. */
const CELL = 329.5;
const PITCH = CELL + 16;
const GRID_X = 73;
const FILM_H = Math.round((1366 * 775) / 1378);
const GRID_Y = 942 + FILM_H + 60;
/* On a phone the same grid in the 362 column: 86 squares, 6 apart,
   24 under the film. */
const M_CELL = 86;
const M_PITCH = 92;
const M_TOP = 243;
const details: [ImageMetadata, number, number][] = [
  [detail6, 0, 0], [detail8, 2, 0], [detail1, 3, 0],
  [detail13, 1, 1], [detail3, 3, 1],
  [detail6B, 0, 2], [detail9, 1, 2], [detail2, 3, 2],
  [detail7, 1, 3], [detail10, 2, 3],
  [detail4, 0, 4], [detail14, 1, 4], [detail15, 3, 4],
  [detail11, 2, 5], [detail12, 3, 5],
];

const pieces = [
  { video: `${base}/media/secrets-book`, controls: true, x: 73, y: 942, w: 1366, h: FILM_H, depth: DRIFT, group: 'details' },
  ...details.map(([src, col, row]) => ({
    src,
    alt: 'A detail from inside the book',
    x: GRID_X + col * PITCH,
    y: GRID_Y + row * PITCH,
    w: CELL,
    h: CELL,
    depth: DRIFT,
    group: 'details',
    m: { x: 20 + col * M_PITCH, y: M_TOP + row * M_PITCH, w: M_CELL },
  })),
];
---

<BaseLayout title={`${title} — ${siteConfig.name}`} description={description} image={bookLeft.src}>
  <!-- The page stands on the picture its hover brings up on the home page,
       the whole way down. It holds the window, as the hover does, and the
       page scrolls over it: drawn down the full length of the page it would
       be stretched to several times its size and break up. Her file as she
       exported it, not encoded again. -->
  <img class="page-backdrop" src={backdrop.src} width={backdrop.width} height={backdrop.height} alt="" aria-hidden="true" />

  <ProjectHeader
    slug="secrets"
    number="05"
    title={title}
    description={description}
    stays={[
      /* "00 3" and "00 2" are the two books of the same photograph, cut out of
         it. Each box keeps the book's own 757x983, scaled to fit the bounding
         box Figma reports (183.6,336 313.7x427.8 and 385.9,530 277.6x401.5)
         at its turn, and centred on it.
         At her ask the pair stands to the right of the title and description,
         20% larger: the two as Figma arranges them (turned, together
         154-634 x 440-979 on the page), scaled 1.2 about their top left and
         moved so that corner lands at 1060,300 — 63 clear of the
         description's column, and ending at 1635 x 947, inside the fold. */
      { src: bookLeft, x: 1099.5, y: 328.6, w: 297.6, h: 385.2, rotate: -13 },
      { src: bookRight, x: 1316.7, y: 542.2, w: 303.6, h: 393.6, rotate: 4.5 },
    ]}
  />

  <ProjectCanvas width={1512} height={4809} offsetY={902} tail={160} items={pieces} />

  <!-- Each detail opens large, and pages through the rest in the grid's
       order, at her ask. -->
  <Lightbox selector='.project-canvas .item[data-group="details"] img' label="Details from the book" />

  <ProjectPager slug="secrets" />
</BaseLayout>

<style>
  .page-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* The opening frame paints itself in the page colour; here that colour is
     clear, so it lets the picture through. */
  :global(main > .canvas-wrap) {
    --color-bg: transparent;
  }
</style>
