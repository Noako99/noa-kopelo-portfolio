---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectHeader from '@components/project/ProjectHeader.astro';
import ProjectPager from '@components/project/ProjectPager.astro';
import ProjectCanvas from '@components/project/ProjectCanvas.astro';
import ParallaxMedia from '@components/project/ParallaxMedia.astro';
import VimeoEmbed from '@components/project/VimeoEmbed.astro';

import main1 from '@assets/projects/more-than-i-love-my-life/main-1-poster.jpg';
import main3 from '@assets/projects/more-than-i-love-my-life/main-3-poster.jpg';
import six from '@assets/projects/more-than-i-love-my-life/six.png';
import untitledArtwork from '@assets/projects/more-than-i-love-my-life/untitled-artwork-2.png';
import layer15 from '@assets/projects/more-than-i-love-my-life/layer-15.png';
import elevenEleven from '@assets/projects/more-than-i-love-my-life/eleven-eleven.png';
import layer14 from '@assets/projects/more-than-i-love-my-life/layer-14.png';
import layer71 from '@assets/projects/more-than-i-love-my-life/layer-71.png';
import layer16 from '@assets/projects/more-than-i-love-my-life/layer-16.png';
import layer8 from '@assets/projects/more-than-i-love-my-life/layer-8.png';
import layer12 from '@assets/projects/more-than-i-love-my-life/layer-12.png';
import layer91 from '@assets/projects/more-than-i-love-my-life/layer-9.png';
import layer2 from '@assets/projects/more-than-i-love-my-life/layer-2.png';
import layer3 from '@assets/projects/more-than-i-love-my-life/layer-3.png';
import layer4 from '@assets/projects/more-than-i-love-my-life/layer-4.png';
import layer6 from '@assets/projects/more-than-i-love-my-life/layer-6.png';
import layer7 from '@assets/projects/more-than-i-love-my-life/layer-7-2.png';
import layer13 from '@assets/projects/more-than-i-love-my-life/layer-13.png';
import { siteConfig } from '@config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'More Than I Love My Life';
const description =
  "A fictional TV title sequence for David Grossman's 'More Than I Love My Life'. Layers of archival footage and experimental editing unpack raw memory, emotion, and complex family bonds. The mixed-media sequence blends hand-crafted typography, archival film, photography, and AI-generated imagery, driven by a deliberate rhythm that echoes generational trauma.";

/* Every coordinate is read straight off the Figma project frame (1512x5525).
   Everything below the film climbs at a speed that grows the further down it
   starts — the stills, the lettering and the archival photographs alike — so
   the whole run gathers into a pile as the page is scrolled, later pieces over
   earlier ones. Pieces that share a line in Figma share a speed, so they stay
   on it.

   Every gap in the run is 68: the film to the stills, the stills to the
   lettering, the lettering to the photographs. The photographs keep the
   overlaps the file draws between themselves — that pile is the design — but
   the boundaries between the blocks are all the same.

   The photographs are laid out as Figma's "More Than I Love My Life" frame
   (node 142:401) draws them, the whole pile lifted 15 so it opens 68 under
   the lettering (the frame leaves 83). Turned ones give the picture's own
   size, centred on the turned box Figma reports. They climb a little faster
   row by row — gently, so the pile keeps the file's arrangement as it
   gathers — and stack in the file's order: Layer 7 underneath, Layer 2 on
   top. */
const PILE = -15;
const pieces = [
  { src: main1, alt: 'Title sequence still', x: 137, y: 1744, w: 606, h: 341, depth: 0.05, lift: 1 },
  { src: main3, alt: 'Title sequence still', x: 768, y: 1744, w: 606, h: 341, depth: 0.05, lift: 1 },
  /* Figma zooms the fill right in on the lettering. */
  { src: six, alt: 'Title sequence typography', x: 422, y: 2153, w: 736, h: 355, depth: 0.12, lift: 2,
    crop: { left: -89.46, top: -90.79, w: 266.24, h: 284 } },
  { src: untitledArtwork, alt: 'Title sequence artwork', x: 219, y: 2423, w: 1098, h: 603, depth: 0.19, lift: 3,
    crop: { left: -47.27, top: -0.01, w: 153.64, h: 144.12 } },
  { src: layer7, alt: 'Archival photograph', x: 1023.49, y: 4198 + PILE, w: 375, h: 529, depth: 0.34, lift: 1 },
  { src: layer15, alt: 'Archival photograph', x: 147, y: 3109 + PILE, w: 375, h: 526, depth: 0.24, lift: 4 },
  { src: elevenEleven, alt: 'Archival photograph', x: 650, y: 3109 + PILE, w: 729, h: 958, depth: 0.24, lift: 5 },
  { src: layer14, alt: 'Archival photograph', x: 349, y: 3539 + PILE, w: 458, h: 586, depth: 0.27, lift: 6 },
  { src: layer71, alt: 'Archival photograph', x: 83, y: 3832 + PILE, w: 531, h: 708, depth: 0.3, lift: 7 },
  /* Turned 7.87°: 379 x 532, centred on 675.49,3977 448.29 x 578.90. */
  { src: layer6, alt: 'Archival photograph', x: 710.14, y: 4000.45 + PILE, w: 379, h: 532, rotate: 7.87, depth: 0.32, lift: 8 },
  { src: layer13, alt: 'Archival photograph', x: 462.49, y: 4495 + PILE, w: 456, h: 588, depth: 0.36, lift: 9 },
  { src: layer4, alt: 'Archival photograph', x: 832.49, y: 4727 + PILE, w: 382, h: 532, depth: 0.38, lift: 10 },
  /* Turned -3.67°: 390 x 527, centred on 137,4397.04 422.97 x 550.91. */
  { src: layer2, alt: 'Archival photograph', x: 153.49, y: 4409.0 + PILE, w: 390, h: 527, rotate: -3.67, depth: 0.36, lift: 11 },
];
---

<BaseLayout title={`${title} — ${siteConfig.name}`} description={description} image={main1.src}>
  <ProjectHeader
    slug="more-than-i-love-my-life"
    number="04"
    title={title}
    description={description}
    stays={[
      /* The opening row of Figma's frame 142:401. Its x runs on the 1512
         project frame, so its left edges are carried onto this 1728 header
         at 8/7, as the hover pieces always were (70.28 -> 80.3); sizes and
         heights stay as drawn. A turned one gives the picture's own size,
         centred in its turned box once that box's left edge is carried over.
         Layer 3 sits under the others, as in the file. */
      { src: layer3, x: 541.71, y: 358, w: 248, h: 353 },
      /* -7.63°: 211 x 296 in a 248.45 x 321.40 box at 80.3,320.3. */
      { src: layer16, x: 99.0, y: 333.0, w: 211, h: 296, rotate: -7.63 },
      { src: layer8, x: 314.29, y: 503, w: 257, h: 352 },
      /* 7.63°: 216 x 346 in a 260.02 x 371.61 box at 949.7,453, the fill a
         hair wider than the box. */
      { src: layer12, x: 971.7, y: 465.8, w: 216, h: 346, rotate: 7.63, crop: { left: -0.09, top: 0, w: 101.11, h: 100 } },
      /* "Layer 91 1" (node 250:85, layer-9.png) lies on the page over the
         frame rather than inside it, and on top of everything: 511,660.12
         against the frame, a 401.49 x 300.54 box, the photograph 371 x 254
         turned -7.63°, the angle that box and its 619 x 423 shape give. */
      { src: layer91, x: 599.1, y: 683.6, w: 371, h: 254, rotate: -7.63 },
    ]}
  />

  <ParallaxMedia>
    <VimeoEmbed id="1216161109" title="More than I love my life — Title sequence" />
  </ParallaxMedia>

  <ProjectCanvas width={1512} height={5525} offsetY={1676} tail={140} items={pieces} />

  <ProjectPager slug="more-than-i-love-my-life" />
</BaseLayout>
